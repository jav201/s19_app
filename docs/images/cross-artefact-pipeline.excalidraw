    {
      "type": "text",
      "id": "lane1_code",
      "x": 78,
      "y": 234,
      "width": 540,
      "height": 104,
      "text": "S3 15 08000000 C5D71484F8CF9BF4... 19\n│  │  │        │                   └ checksum\n│  │  │        └ 16 data bytes\n│  │  └ address 0x08000000\n│  └ byte count 0x15 = 21\n└ S3 record = 32-bit address",
      "originalText": "S3 15 08000000 C5D71484F8CF9BF4... 19\n│  │  │        │                   └ checksum\n│  │  │        └ 16 data bytes\n│  │  └ address 0x08000000\n│  └ byte count 0x15 = 21\n└ S3 record = 32-bit address",
      "fontSize": 13,
