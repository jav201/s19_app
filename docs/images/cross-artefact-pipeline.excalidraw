    {
      "type": "text",
      "id": "thread_text",
      "x": 82,
      "y": 846,
      "width": 1500,
      "height": 80,
      "text": "firmware.a2l   MEAS_000000   ECU_ADDRESS 0x08001400   ->  no S19 range covers it        CROSS_A2L_S19_OUT_OF_RANGE\nfirmware.mac   MEAS_000000   =           0x08000000   ->  inside 0x08000000-0x08000100  \nfirmware.mac   MEAS_000000   =           0x08000028   ->  same name declared twice      MAC_DUPLICATE_NAME\n                                                      ->  A2L address != MAC address    TRIPLE_NAME_ADDRESS_MISMATCH",
      "originalText": "firmware.a2l   MEAS_000000   ECU_ADDRESS 0x08001400   ->  no S19 range covers it        CROSS_A2L_S19_OUT_OF_RANGE\nfirmware.mac   MEAS_000000   =           0x08000000   ->  inside 0x08000000-0x08000100  \nfirmware.mac   MEAS_000000   =           0x08000028   ->  same name declared twice      MAC_DUPLICATE_NAME\n                                                      ->  A2L address != MAC address    TRIPLE_NAME_ADDRESS_MISMATCH",
      "fontSize": 15,
