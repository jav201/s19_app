/* s19_app/tui/styles.tcss
 *
 * Direction B "Calm Dark" theme for the s19tui Textual app.
 *
 * Origin: extracted verbatim from the former inline `S19TuiApp.CSS` block in
 * app.py (carried 1:1, every `#id` rule preserved), then re-themed onto the
 * Calm Dark token set. This is the LLR-005.1 / LLR-005.2 deliverable for
 * Phase 3 increment 1 of batch-02-direction-b-restyle.
 *
 * Theme contract (TC-012 token budget):
 *  - exactly ONE accent hue, declared as the custom variable `$accent-calm`;
 *  - dark-only background / foreground / rule tokens (no light variant);
 *  - the five `sev-*` rules keep their class names and severity meaning
 *    (color_policy.SEVERITY_CLASS_MAP) — only the hex values are tuned;
 *  - the `.mac_out_of_range` MAC overlay rule is preserved.
 *
 * color_policy.py is NOT touched: SEVERITY_CLASS_MAP, css_class_for_severity,
 * MAC_ADDRESS_OVERLAY_STYLE and FOCUS_HIGHLIGHT_STYLE stay byte-identical.
 */

/* --- Calm Dark token set -------------------------------------------------
 * One accent hue + dark-only structural tokens. Textual's own `$primary`,
 * `$accent`, `$text`, `$background` are theme built-ins; the tokens below are
 * the batch-02 Calm Dark layer. `$accent-calm` is the single accent hue.
 */
$accent-calm: #91abec;          /* the one accent — navy/pastel hilite (insight_style.HILITE) */
$bg-base: #0a0e1b;              /* dark-only app background (insight_style.DEPTH_BG) */
$bg-panel: #0f1525;             /* dark-only panel surface (insight_style.DEPTH_PANEL) */
$fg-base: #e9e9e9;              /* dark-only primary foreground (insight_style.VALUE) */
$rule: #1b233a;                 /* dark-only border / divider tone (insight_style.DEPTH_BORDER) */
$odd-row: #131a2c;             /* zebra odd-row surface (insight_style.DEPTH_ODD_ROW) */
$crc-family: #c9562b;          /* the CRC block colour, flow screens (insight_style.CRC_FAMILY) */
$waiting-human: #e8ad3d;       /* the waiting-for-a-human role, flow screens (insight_style.WAITING_HUMAN) */

Screen {
    layout: vertical;
    padding: 1;
    background: $bg-base;
    color: $fg-base;
}

.hidden {
    display: none;
}

/* --- Direction B app shell (batch-02 increment 2) ------------------------
 * `#workspace_shell` is the horizontal split of the activity-rail slot and
 * the 8-screen `#workspace_body`. The rail/command-bar widgets land in
 * increments 3-4; their mount slots are placed here now. The two-regime
 * width layout (LLR-007.1) is governed by the `width-narrow` class, toggled
 * on `#workspace_body` below the 120-column breakpoint.
 */
#command_bar_slot {
    height: auto;
}

/* --- Direction B command bar (batch-02 increment 4) ---------------------
 * AMENDED at batch-79 Inc-11, as `LLR-118.3` explicitly requires.
 *
 * `#command_bar` is now a PALETTE HOST and nothing else: its only child is the
 * `#command_palette` dropdown, hidden until `Ctrl+K`. LLR-003.2 / 003.3.
 *
 * It is no longer a "persistent top bar". The single-row `#command_bar_row`
 * this comment used to describe — accent `›` prompt, project/A2L context
 * labels, find and go-to inputs — was DELETED by `HLR-118` at Inc-10, and its
 * LLR-003.1 / 004.1 / 004.2 / 004.3 / 011.3 responsibilities went with it:
 * the context labels to `#status_context` and the Loaded panel's project row
 * (`HLR-120`), the `/` and `g` keys to each screen's own inputs (`HLR-119`).
 * The deletion record is the comment immediately below.
 */
#command_bar {
    height: auto;
    width: 100%;
}

/* batch-79 Inc-10 (HLR-118): the `#command_bar_row` block and the five child
 * rules it governed (`#command_bar_prompt`, `#cmdbar_project`, `#cmdbar_a2l`,
 * `#find_input`, `#cmdbar_goto_input`) are DELETED with the row itself.
 *
 * The deleted span ran from THIS comment down to (not including) the
 * `#command_palette` rule. `#command_bar_slot` and `#command_bar` sit ABOVE it
 * and SURVIVE: they host the palette, which outlives the bar. A deletion
 * starting at the `#command_bar` header comment instead would have removed the
 * styling of the container that stays — which is what the spec's original
 * ":55-102" span would have done.
 *
 * batch-79 Inc-11: this paragraph used to cite the span as ":66-103" with
 * ":51" and ":61" for the two survivors, and amending the header comment above
 * shifted all three by nine lines the same day. Those citations are replaced
 * with the SYMBOL NAMES deliberately — a line number is not a durable
 * reference to a rule, and this batch has now paid for that three times. */

#command_palette {
    height: auto;
    width: 100%;
    background: $bg-panel;
    border: round $accent-calm;
}

#command_palette.hidden {
    display: none;
}

#palette_list {
    height: auto;
    max-height: 12;
    background: $bg-panel;
}

#workspace_shell {
    layout: horizontal;
    height: 1fr;
}

#rail_slot {
    width: auto;
    height: 100%;
}

#workspace_body {
    width: 1fr;
    height: 100%;
}

/* Each rail screen container fills the workspace body; `.hidden` hides the
 * inactive seven so exactly one screen is visible at a time (LLR-002.1). */
.db-screen {
    width: 100%;
    height: 100%;
}

.db-screen-title {
    text-align: center;
    width: 100%;
    background: $accent-calm;
    color: $bg-base;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

/* --- Open-folder chip (batch-95 change 2, HLR-139) ----------------------
 * One ghost chip per window header row, seated header-right by
 * ``titled_header`` (open_folder_chip.py): the compact 1-tall borderless
 * chip shape of ``.patch-chip`` (LLR-076), in the one accent hue, on a
 * transparent background. The missing-target state is an EXPLICIT
 * ``-dimmed`` class (NOT ``disabled`` — the create-offer IS a press,
 * LLR-139.2); the dim reuses textual's own disabled cue
 * (``text-opacity: 0.6``, Button DEFAULT_CSS) so a dimmed chip and a
 * disabled one read identically. The no-project Reports chip is the one
 * genuinely ``disabled`` limb (its press is swallowed — the 0-open
 * contract) and carries ``-dimmed`` so the state stays class-visible. */
.db-screen-header {
    width: 1fr;
    height: auto;
}

.db-screen-header .db-screen-title,
.db-screen-header .modal-title {
    width: 1fr;
}

.open-folder-chip {
    height: 1;
    min-width: 8;
    border: none;
    text-style: bold;
    background: transparent;
    color: $accent-calm;
    margin-bottom: 1;
}

.open-folder-chip.-dimmed {
    text-opacity: 0.6;
}

/* batch-95 change 3 (HLR-140): the per-window `?` usage-help ghost chip.
 * The same compact 1-tall borderless chip shape as `.open-folder-chip`,
 * narrowed to its single glyph; it rides the `.db-screen-header` row
 * between the title label and the open-folder chip (never displacing it). */
.window-help-chip {
    height: 1;
    min-width: 3;
    border: none;
    text-style: bold;
    background: transparent;
    color: $accent-calm;
    margin-bottom: 1;
}

/* LLR-002.3 empty-state panel — neutral no-file-loaded prompt. */
#empty_state_panel {
    width: 100%;
    height: auto;
    padding: 2 2;
    color: $fg-base;
}

/* --- Density variants (LLR-006.1 / LLR-006.2) ----------------------------
 * Comfortable is the default startup density (set on `#workspace_body` in
 * `on_mount`). Compact tightens pane padding; A2L/MAC density tuning lands
 * with those screens in increment 6.
 */
#workspace_body.density-comfortable #workspace_panes .db-pane {
    padding: 1;
}

#workspace_body.density-compact #workspace_panes .db-pane {
    padding: 0 1;
}

/* --- Workspace 3-pane re-layout (batch-02 increment 5, LLR-008.1) --------
 * The Direction B Workspace replaces the pre-batch 5-tile `#main_layout`
 * grid with a horizontal three-pane split: left data ranges/sections,
 * center hex view, right context. Two width regimes (LLR-007.1):
 *   - terminal width >= 120: fixed side panes (left 22, right 40), center 1fr
 *   - terminal width  < 120: proportional side panes (left 24%, right 30%),
 *     center 1fr — applied via the `width-narrow` class toggled on
 *     `#workspace_body` by `on_resize`.
 */
#workspace_panes {
    layout: horizontal;
    height: 1fr;
}

/* batch-28 (R-TUI-042, US-040 / LLR-042.8): Workspace whole-image memory strip.
 * A single-row band ABOVE `#workspace_panes` (which now takes the `1fr`
 * remainder) spanning the workspace body width — it does NOT touch the fixed
 * 22-col `#ws_left` budget. Bounded to one content row so `#ws_center`'s hex
 * view still renders >= 1 row at 80x24 (C-13 geometry, batch-17 mode). Cells lay
 * out horizontally; their `sev-*` class supplies the valid/invalid/gap colour. */
#ws_memstrip {
    height: 1;
    width: 100%;
    layout: horizontal;
    margin-bottom: 1;
}

.strip-cell {
    width: 1;
    height: 1;
}

/* Unload feature Inc-2 — the persistent Workspace "Loaded" panel
 * (`#loaded_panel`): a compact readout of the three typed artifact slots
 * (S19/HEX · MAC · A2L). It lives OUTSIDE `#workspace_panes` so it stays visible
 * in the no-file empty state. Kept deliberately borderless/marginless so its
 * footprint (title + 3 slot rows + unload-all row = 5 rows) survives the 80x24
 * floor geometry budget (C-13/C-23) without clipping the hex panes below. Slot
 * rows are re-mounted per render (addressed by CLASS, never id — the
 * `MemoryMapPanel` pattern), so every rule keys on classes. Colours reuse the
 * batch-47 navy/pastel insight tokens: `$accent-calm` for the `[u]`/`[U]`
 * affordance + the title, `#969aad` (insight_style.DGRAY) for the dim absent
 * slots. */
#loaded_panel {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#loaded_title {
    width: 100%;
    height: 1;
    color: $accent-calm;
    text-style: bold;
}

#loaded_slots {
    width: 100%;
    height: auto;
    layout: vertical;
}

/* 80x24-floor graceful degradation (C-13/C-23). Under the `width-narrow`
 * regime the workspace body is only ~9 rows tall (the status bar/log tail eats
 * the rest), so a full 5-row panel would clip the hex panes below. Narrow ⇒
 * drop the title and cap the slot list to 2 scrollable rows: the two lead slots
 * stay visible and the panes keep a positive height. The `U` key still unloads
 * all, and per-slot `[u]` stays reachable, so no function is lost at the floor.
 * Wide (>=120) keeps the full auto-height vertical panel. */
#workspace_body.width-narrow #loaded_title {
    display: none;
}

#workspace_body.width-narrow #loaded_slots {
    height: 2;
    overflow-y: auto;
}

.loaded-slot,
.loaded-allrow {
    width: 100%;
    height: 1;
}

.loaded-kind {
    width: 6;
    height: 1;
    color: $accent-calm;
    text-style: bold;
}

/* `.loaded-detail` marks the three ARTIFACT slots' detail cell. Two shipped
 * readers select on it and index the result POSITIONALLY as
 * [primary, mac, a2l], so the Loaded panel's project row (LLR-120.2) carries
 * `.loaded-project-detail` instead — listed beside it here so the two keep
 * identical geometry and only the marker differs. Adding a fourth
 * `.loaded-detail` cell breaks those readers; it did, for six tests. */
.loaded-detail,
.loaded-project-detail {
    width: 1fr;
    height: 1;
    color: $fg-base;
}

/* Absent slot (and the disabled unload-all label): dim (insight_style.DGRAY). */
.loaded-absent {
    color: #969aad;
}

.loaded-slot-absent .loaded-kind {
    color: #969aad;
    text-style: none;
}

/* The `[u]` / `[U]` affordance — a compact borderless accent control that reads
 * as an inline bracketed button within the 80-col floor. */
.loaded-unload {
    width: auto;
    min-width: 3;
    height: 1;
    color: $accent-calm;
    background: $bg-panel;
}

.loaded-unload:hover {
    color: $bg-base;
    background: $accent-calm;
    text-style: bold;
}

.loaded-alllabel {
    width: 1fr;
    height: 1;
    color: $fg-base;
    text-align: right;
    padding-right: 1;
}

/* >= 120-column fixed-width regime (LLR-008.1). */
#ws_left {
    width: 22;
    height: 100%;
}

#ws_center {
    width: 1fr;
    height: 100%;
}

#ws_right {
    width: 40;
    height: 100%;
}

/* < 120-column proportional regime (LLR-008.1 / LLR-007.1). */
#workspace_body.width-narrow #ws_left {
    width: 24%;
}

#workspace_body.width-narrow #ws_right {
    width: 30%;
}

/* The center hex pane stays `1fr` in both regimes — it always receives the
 * strictly-positive remainder after the side panes (LLR-008.1). */
#workspace_body.width-narrow #ws_center {
    width: 1fr;
}

/* batch-47 US-FND (LLR-065.3): the dolphie panel idiom — a `tall` framed
 * border with an accent border-title and a muted border-subtitle, over the
 * navy panel surface. Applied to the broad `.db-pane` class so every screen's
 * titled panes (border titles set in Phase-3 Inc-3, LLR-066.1) pick it up. */
.db-pane {
    border: tall $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
    border-subtitle-color: #969aad;
    background: $bg-panel;
    padding: 1;
    height: 100%;
}

/* batch-47 US-FND (LLR-065.3): zebra odd-row surface for the record/tag
 * DataTables — a subtle navy step above the panel surface. Applies only where
 * a DataTable enables `zebra_stripes`; inert elsewhere. */
DataTable > .datatable--odd-row {
    background: $odd-row;
}

/* batch-31 AC-7 (B-20): compact one-row Load-project button — borderless so
 * it costs a single row of the tight 22-col left pane (C-13 budget). */
#ws_load_project_button {
    width: 100%;
    height: 1;
    min-width: 0;
    border: none;
}

#ws_left #sections_list {
    height: 1fr;
}

/* batch-31 AC-5 (B-06): the work-area file list shares the left pane
 * elastically instead of the former fixed 8-row cap, so taller terminals
 * show more files. Sections and files split the remainder 1:1; at 80x24
 * both stay scrollable, preserving the C-13 geometry budget. */
#ws_left #files_list {
    height: 1fr;
}

/* --- A2L Explorer 2-pane re-layout (batch-02 increment 6 / 13, LLR-009.1) -
 * The Direction B A2L Explorer replaces the pre-batch 2x2 `#alt_layout`
 * grid with a horizontal two-pane split: left tags table, right hex view.
 * Increment 13 (review feedback — the fixed-40 hex pane was too narrow to
 * show hex content correctly) supersedes the increment-6 two-regime
 * `40 / 35%` split FOR A2L ONLY with a flat proportional 3:4 ratio: the
 * hex pane is `3fr` and the tags pane `4fr`, so the hex pane is exactly
 * 3/7 of the A2L content width at ALL terminal widths. Because the ratio
 * is already proportional, no `width-narrow` rule is needed for A2L.
 * MAC View (`#mac_*`, LLR-010.1) keeps the increment-6 two-regime layout.
 * Every widget subtree is reused verbatim; no renderer/paging/jump/filter
 * logic is touched (LLR-009.2).
 * batch-95 change 3 (HLR-140): the height is `1fr` instead of `100%` —
 * the change-3 header row (title + `?` chip) now leads `#screen_a2l`, so
 * the panes take the remainder; with `100%` the header would clip the
 * panes' bottom row. As the only remaining child this renders identically
 * to the former `100%`. */
#a2l_panes {
    layout: horizontal;
    height: 1fr;
}

/* Flat 3:4 proportional ratio at every terminal width (LLR-009.1,
 * increment 13). The hex pane is 3/7 of the A2L content width; the tags
 * pane is the 4/7 remainder. */
#a2l_tags_pane {
    width: 4fr;
    height: 100%;
}

#a2l_hex_pane {
    width: 3fr;
    height: 100%;
}

/* --- MAC View 2-pane re-layout (batch-06 increment 1, LLR-001.1-.4) -----
 * Batch-06 supersedes the increment-6 two-regime MAC layout with the same
 * flat proportional split A2L adopted in increment 13: the records pane
 * is `4fr` and the hex pane `3fr` (3/7 of the MAC content width) at ALL
 * terminal widths, plus a `min-width` floor on the hex pane so a full hex
 * row (`> ` marker + address + 16 bytes + ASCII gutter, 82 cells) never
 * truncates when the proportional share would be smaller. This single
 * proportional+floor regime applies everywhere — the former `width-narrow`
 * MAC rules are removed (the class itself still toggles at 120 cols for
 * the workspace activity rail, which is unrelated to MAC sizing).
 */
#mac_panes {
    layout: horizontal;
    height: 100%;
}

/* Flat 4:3 proportional ratio with a full-row floor on the hex pane
 * (batch-06 LLR-001.1 / LLR-001.2 / LLR-001.3). */
#mac_records_pane {
    width: 4fr;
    height: 100%;
}

#mac_hex_pane {
    width: 3fr;
    min-width: 82;
    height: 100%;
}

/* Inner scroll container of the MAC hex pane — mirrors `#hex_scroll` so the
 * embedded hex viewer fills the vertical extent below the title/controls
 * (HLR-002 / LLR-002.2). */
#mac_hex_scroll {
    height: 100%;
    overflow: auto;
}

#a2l_tags_filters {
    layout: horizontal;
    height: auto;
    padding-bottom: 1;
}

#a2l_tags_filter_input {
    width: 1fr;
}

#a2l_tag_find_input {
    width: 1fr;
}

#a2l_filter_menu {
    border: round $rule;
    background: $bg-panel;
    padding: 1;
    height: 8;
}

#a2l_filter_menu.hidden {
    display: none;
}

#settings_menu {
    border: round $rule;
    background: $bg-panel;
    padding: 1;
    width: 48;
    height: 12;
}

#settings_menu.hidden {
    display: none;
}

/* --- Persistent status bar (batch-02 increment 7) -----------------------
 * `#workspace_status_bar` is the Direction B home for the status text,
 * progress bar and 4-line log tail re-homed from the dismantled Workspace
 * Status tile. It sits above the footer and is visible on every screen so
 * `set_status` / `set_file_status` / `set_progress` and the log tail keep
 * a stable render target (LLR-013.2 status-bar area).
 */
#workspace_status_bar {
    height: auto;
    border-top: solid $rule;
    background: $bg-panel;
    padding: 0 1;
}

/* LLR-120.3 — the context SHARES the status row instead of taking one of its
 * own. `#status_line` is a one-row `Horizontal` holding `#status_text` (owned
 * by `set_status` / `set_file_status`) and `#status_context` (owned by
 * `update_project_labels`). Two widgets, one row: an eighth row on this bar
 * costs a row on all 10 screens, and the diff pane has 2 content rows to
 * begin with.
 *
 * `height: 1` is deliberate rather than `auto`. The bar's own height is
 * `auto`, so a context string long enough to wrap would grow this row and take
 * the bar to 8 — the exact regression `AT-B78-11` gates. Fixed at one row, an
 * over-long context is CLIPPED, which is a display loss, not a layout
 * regression. */
#status_line {
    height: 1;
    width: 100%;
}

/* `1fr`, NOT `auto`. Under `auto` this label sizes to its content and takes
 * whatever it wants — measured, a routine `set_file_status` coexistence
 * message ("Loaded <name>.s19 (S19+MAC: <name>.mac)") reached **93 columns on
 * an 80-column terminal**, leaving `#status_context` 1 column wide and
 * painting NOTHING. HLR-120's own threshold ("the status bar's text contains
 * both on 10 of 10 screens") was false at 80x24 while the widget's
 * `render()` still returned the full string — which is why the acceptances
 * could not see it. `1fr` + ellipsis makes the transient MESSAGE truncate
 * instead of the ambient CONTEXT vanishing. */
#workspace_status_bar #status_text {
    height: auto;
    color: $fg-base;
    width: 1fr;
    text-overflow: ellipsis;
}

/* Right-aligned so the context reads as ambient state rather than competing
 * with the status message at the left edge.
 *
 * `auto` with a ceiling: the context sizes to its CONTENT, so it is never
 * starved by a long status message, and `max-width` stops a long project+A2L
 * pair from starving the message in return.
 *
 * ⚠️ `max-width` bounds this cell against the status MESSAGE. It cannot bound
 * the project against the A2L — both live in one `Label` as one string, so CSS
 * can only clip the tail, which is the A2L. That second bound is
 * `_compose_context_line` in `app.py`, and its budget is derived from this
 * `70%` (`_CONTEXT_MAX_SHARE`) plus the chrome inset; `TC-B79-02` asserts both
 * couplings against the live tree.
 *
 * `$fg-base`, not a dimmer tone: this stylesheet's palette is a CLOSED set of
 * six tokens (`$accent-calm`, `$bg-base`, `$bg-panel`, `$fg-base`, `$rule`,
 * `$odd-row`) and carries no muted foreground. Minting one would be a change
 * to the design system on the way past, which is not this increment's scope —
 * separation is carried by position and alignment instead. Registered as a
 * candidate, not taken.
 *
 * batch-79 Inc-11: this block previously opened by claiming `width: 1fr`
 * takes whatever the status text leaves. The rule below sets `width: auto`,
 * and a second comment saying so was stacked underneath rather than replacing
 * it — two blocks on one rule, the first contradicting the second. Merged. */
#workspace_status_bar #status_context {
    height: 1;
    width: auto;
    max-width: 70%;
    color: $fg-base;
    text-align: right;
    text-overflow: ellipsis;
}

#workspace_status_bar Label {
    height: auto;
}

#progress_bar {
    margin-top: 1;
}

#a2l_view {
    height: 100%;
    overflow: auto;
}

#hex_scroll {
    height: 100%;
    overflow: auto;
}

/* US-018: the hex view sizes to its content width (one full 16-byte + ASCII
 * row, ~81 cells) instead of wrapping to the pane; `#hex_scroll`'s
 * `overflow: auto` then provides a horizontal scrollbar when the pane is
 * narrower than a row, so the row stays on ONE line and all three Workspace
 * panes remain visible (a `min-width` floor on `#ws_center` would instead push
 * the right context pane off-screen at <~168-col terminals). */
#hex_view {
    width: auto;
}

#hex_controls {
    layout: horizontal;
    height: auto;
    padding-bottom: 1;
}

#search_input, #goto_input {
    width: 1fr;
}

#alt_hex_controls,
#mac_hex_controls {
    layout: horizontal;
    height: auto;
    padding-bottom: 1;
}

#alt_search_input, #alt_goto_input,
#mac_search_input, #mac_goto_input {
    width: 1fr;
}

#a2l_scroll {
    height: 100%;
    overflow: auto;
}

/* batch-28 (R-TUI-042, US-040 / LLR-042.9): Workspace stat pane. The stats
 * block sits above the Context scroll in `#ws_right` as a content-height band;
 * the Context ScrollableContainer takes the remaining height (`1fr`) so the
 * stat pane never pushes the hex/context off-screen (C-13 geometry). */
#ws_right #ws_stats {
    height: auto;
    padding-bottom: 1;
}

#ws_right #a2l_scroll {
    height: 1fr;
}

#mac_scroll {
    height: 100%;
    overflow: auto;
}

#a2l_tags_list {
    height: 1fr;
}

/* A2L Explorer compact density (US-038, LLR-042.2). Mirrors the
 * `#workspace_body.density-compact` precedent (base `.db-pane` padding: 1 ->
 * 0 1). The class is a queryable density marker (AT-038b); the compact rows
 * themselves come from the DataTable `cell_padding=0` set in `_compose_screen_a2l`. */
#a2l_tags_pane.density-compact {
    padding: 0 1;
}

#a2l_tags_summary {
    height: auto;
    padding: 0 1;
    color: $fg-base;
}

#mac_records_list {
    height: 1fr;
}

#mac_records_summary {
    height: auto;
    padding: 0 1;
    color: $fg-base;
}

#alt_hex_scroll {
    height: 100%;
    overflow: auto;
}


/* --- Severity classes (LLR-005.2 / batch-47 LLR-065.4) -------------------
 * Class names and severity meaning are fixed by color_policy.SEVERITY_CLASS_MAP
 * and MUST NOT change. Only the hex values are tuned — batch-47 US-FND aligns
 * them to the navy/pastel insight_style palette (§6.5 Amendment C). The hue
 * FAMILY (and thus the severity semantics) is preserved for every class:
 * ok=green, error=red, warning=warm, info=cyan, neutral=grey.
 *
 * NOTE (§6.5 Amendment F, 2026-07-16): an earlier version of this comment said
 * the "Orange = MAC warning" cue "lives in the separate .mac_out_of_range
 * overlay". That was WRONG — .mac_out_of_range paints only the Sections-list
 * "MAC out-of-range @ 0x…" labels (app.py), NOT the MAC/Issues warning ROWS,
 * which are painted css_class_for_severity(WARNING) = .sev-warning. Retuning
 * .sev-warning below therefore DID move the documented row cue orange→yellow.
 * Resolved per operator decision: warning severity renders pale yellow on all
 * screens; ORANGE is re-scoped to the MAC-specific cues — the ⚠ record glyph
 * (orange3), the hex MAC overlay (frozen MAC_ADDRESS_OVERLAY_STYLE =
 * "bold orange3"), and .mac_out_of_range (#d9a35b, unchanged below).
 * REQUIREMENTS.md's severity-convention section is amended to match.
 */
.sev-ok {
    color: #54efae;              /* was #5fb98a — insight_style.GREEN */
}

.sev-error {
    color: #fd8383;              /* was #e06c75 — insight_style.RED */
}

.sev-warning {
    color: #f6ff8f;              /* was #d9a35b — insight_style.YELLOW */
}

.sev-info {
    color: #7dd3fc;              /* was #4ec9d4 — insight_style.CYAN */
}

.sev-neutral {
    color: #969aad;             /* was #6b7280 — insight_style.DGRAY */
}

/* MAC out-of-range overlay — preserved (pairs with MAC_ADDRESS_OVERLAY_STYLE).
 * Left at the amber/orange3 hue. NOTE (§6.5 Amendment F): this class paints ONLY
 * the Sections-list "MAC out-of-range @ 0x…" labels (app.py) — it does NOT paint
 * the MAC/Issues warning ROWS (those are .sev-warning). An earlier comment here
 * claimed it retained "the Orange = MAC warning cue regardless of the sev-warning
 * restyle"; that was WRONG. Per Amendment F, warning ROWS render pale yellow and
 * ORANGE is re-scoped to the MAC-specific cues: this overlay, the ⚠ record glyph
 * (orange3), and the frozen MAC_ADDRESS_OVERLAY_STYLE hex overlay (LLR-065.4). */
.mac_out_of_range {
    color: #d9a35b;
}

/* entropy band colours (batch-45, R-TUI-060)
 * Class tokens are owned by entropy_style.ENTROPY_BAND_CLASS (NOT the frozen
 * color_policy `sev-*` domain). Colour is a secondary cue — bands also carry a
 * distinct texture glyph (ENTROPY_BAND_GLYPH) so they read without colour (C-10).
 */
.band-constant {
    color: #6b7280;
}

.band-low {
    color: #5fb98a;
}

.band-medium {
    color: #d9a35b;
}

.band-high {
    color: #e06c75;
}

/* --- Issues Report dedicated rail screen (batch-02 increment 7) ----------
 * LLR-011.1: the validation Issues `DataTable`, its severity filter row and
 * the summary line — promoted out of the old Workspace Status tile into
 * `#screen_issues`. The table fills the screen instead of a fixed 12-row
 * tile; severity coloring / filters / paging are unchanged (LLR-011.2).
 */
#issues_content {
    width: 100%;
    height: 1fr;
}

#issues_content.hidden {
    display: none;
}

#validation_issues_filters {
    layout: horizontal;
    height: auto;
    padding-top: 1;
}

#validation_issues_summary {
    height: auto;
    padding: 0 1;
    color: $fg-base;
}

/* --- Memory Map + Bookmarks scaffolds (batch-02 increment 9) -------------
 * LLR-012.1: the Memory Map is a read-only coverage visualization rendered
 * from the existing `LoadedFile.ranges` / `range_validity` — batch-93 makes
 * `#map_content` a NON-scrolling host (the cockpit's region list scrolls
 * inside its own pane, HLR-126, so the one-line stats strip always paints);
 * an `EmptyStatePanel` shows when no file is loaded (LLR-002.3). LLR-002.2:
 * the Bookmarks screen is a neutral "coming soon" placeholder with no
 * persistence logic.
 */
#map_content {
    width: 100%;
    height: 1fr;
    border: round $rule;
    background: $bg-panel;
}

#map_content.hidden {
    display: none;
}

/* batch-93 (HLR-126): the panel fills the (non-scrolling) content host so the
 * cockpit's two panes are height-constrained — the region list and the peek
 * re-apportion against the measured panes instead of growing the host. */
#memory_map_panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
    color: $fg-base;
}

/*
 * batch-93 (HLR-125/126, variant C — the inspector cockpit): `#map_grid` is
 * the left "Memory Map" pane (`.db-pane` chrome: lit title, navy surface,
 * subtitle `{N} regions · ░▒▓ k`) stacking the 1-row band bar, the run-start
 * ruler, the one-line glance chips and the scrollable region list; `#map_detail`
 * is the full-height right "Inspector — 0xADDR" pane (subtitle `↑↓ · ↵ hex`).
 * The header and the `#map_stats` one-line coverage strip span the full panel
 * width, OUTSIDE any scroll region (HLR-129 — the strip always paints without
 * scrolling); `#map_grid` + `#map_detail` share a `#map_body` sub-container
 * laid out per the two-regime reflow below (LLR-041.10).
 */
#map_header {
    width: 100%;
    height: auto;
    color: $fg-base;
}

/*
 * Two-regime reflow (LLR-041.10, re-anchored at batch-93 inc-002 per HLR-131) —
 * reuses the EXISTING `width-narrow` class, NOT a new breakpoint; the rules are
 * keyed on `#memory_map_panel.width-narrow`, which the PANEL toggles from its
 * OWN measured width at `_MAP_STACK_MIN_WIDTH` (86 panel columns, re-measured:
 * side-by-side row widget = panel - 51, the compact row = 35 cells, 51 + 35 =
 * 86 — the smallest panel at which the compact row still fits its widget).
 *   Side-by-side (panel >= 86): `#map_body` is horizontal — the grid pane takes
 *   the `1fr` remainder beside a fixed 44-col `#map_detail` inspector (its
 *   ~40-col interior admits the 33-cell 8-byte peek row, HLR-128).
 *   Stacked (panel < 86): `#map_body` stacks vertically — both panes full
 *   width; no horizontal fixed-sibling contention.
 * The workspace-level `width-narrow` (toggled at the 120-column TERMINAL
 * breakpoint for the other screens) no longer drives the map: the regime
 * decision reads the PANEL's width, never the terminal's — a narrow rail can
 * hand the map a wide panel and the map correctly stays side-by-side.
 */
#map_body {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#memory_map_panel.width-narrow #map_body {
    layout: vertical;
}

/* batch-93 (HLR-125/126): `#map_grid` is the chromed left cockpit pane (the
 * `.db-pane` class carries border/title colours/surface/padding); its id rule
 * keeps the elastic width + the vertical interior stack. The chrome is the
 * shared kit — never a hand-typed style list (LLR-125.1). */
#map_grid {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#memory_map_panel.width-narrow #map_grid {
    width: 100%;
    height: 55%;
}

/* Entropy band bar: the full width of the left pane, which is the basis
 * ``_allocate_band_widths`` apportions (LLR-111.1); one segment per merged run
 * plus a one-column marker per unmapped gap (LLR-111.2). */
.map-band-bar {
    width: 100%;
    height: 1;
    layout: horizontal;
}

.map-band-seg {
    width: auto;
    height: 1;
}

/* batch-93 (HLR-129): the glance chips — the retired 6-row `.at-a-glance`
 * histogram/sparkline dock folded to ONE line of per-band chips between the
 * ruler and the region list. Colour flows through the `band-*` classes on the
 * per-chip widgets; the chips' own rules only lay the line out. The stack
 * carries NO inter-section margins: the map viewport's row budget is the
 * operator's standing complaint (charter S-5), and every margin row is one
 * region row the list cannot show. */
.map-glance-chips {
    width: 100%;
    height: 1;
    layout: horizontal;
}

.map-glance-chip {
    width: auto;
    height: 1;
    margin-right: 2;
}

/* Per-region list: the rows live inside this scroll container (batch-93,
 * HLR-126 — the outer #map_content no longer scrolls, so the one-line stats
 * strip below the cockpit always paints). The container takes the pane's
 * remaining height; the scrollbar renders whenever the rows overflow. The
 * 2-row floor guarantees at least two rows paint wherever the pane is
 * height-constrained (the 80x24 stacked regime hands the pane its natural
 * height and lets #map_body scroll — see the narrow rules below). */
.map-region-scroll {
    width: 100%;
    height: 1fr;
    min-height: 2;
}

/* The `.map-band-legend` container and its `.map-legend-row` children were
   REMOVED at batch-77 (HLR-114); the `.at-a-glance` dock at batch-93 (HLR-129)
   — the rules are deleted rather than left as dead CSS. */
.map-region-list {
    width: 100%;
    height: auto;
}

.map-region-row {
    width: 100%;
    height: 1;
}

/* The selected region row (batch-77, HLR-117 / LLR-117.2). A BACKGROUND and a
   weight only — deliberately NO `color:` and NO `text-style: reverse`. Both of
   those repaint the row's foreground, which is the `band-*` entropy channel:
   `reverse` in particular satisfies a naive "sets no color property" check
   while swapping the band colour into the background, so selecting a row would
   destroy the one signal the row exists to carry. The band token stays on the
   row's class list; this rule is additive. */
.map-region-row.map-region-selected {
    background: $rule;
    text-style: bold;
}

/* batch-93 (HLR-125/126): `#map_detail` is the chromed right cockpit pane —
 * the full-height Inspector. Fixed 44 columns wide (a ~40-col interior admits
 * the 33-cell 8-byte peek row, HLR-128); `.db-pane` carries the chrome.
 * `overflow-y: auto` keeps the field block + peek reachable when a short
 * side-by-side pane cannot show the whole body. */
#map_detail {
    width: 44;
    height: 100%;
    margin-left: 1;
    overflow-y: auto;
}

/* batch-93 narrow regime (panel < `_MAP_STACK_MIN_WIDTH`, HLR-131's stacking,
 * class re-anchored to `#memory_map_panel` at inc-002): the cockpit cannot
 * fit both panes above the always-visible stats strip, so #map_body scrolls
 * as ONE unit — the panes take their natural heights (overview stack +
 * inspector body) and the operator scrolls the body, exactly the shipped
 * pre-batch-93 floor's reachability, while the one-line stats strip still
 * paints without scrolling (HLR-129). A `1fr` child of a height-auto pane
 * collapses to 0 (the shipped Textual trap), so the region list carries a
 * 2-row min-height floor of its own. */
#memory_map_panel.width-narrow #map_body {
    layout: vertical;
    overflow-y: auto;
}

#memory_map_panel.width-narrow #map_grid {
    width: 100%;
    height: auto;
    min-height: 7;
}

#memory_map_panel.width-narrow #map_detail {
    width: 100%;
    height: auto;
    margin-left: 0;
    margin-top: 1;
}

/* Height AUTO (not 100%): the body grows with its content so the pane's
 * overflow-y can scroll it; at full-height panes the content fits and no
 * scrollbar appears. */
#map_detail_body {
    width: 100%;
    height: auto;
    color: $fg-base;
}

#map_open_hex_button {
    margin-top: 1;
}

#map_open_hex_button.hidden {
    display: none;
}

/* batch-93 (HLR-129): the coverage stats strip is ONE always-visible line
 * (LLR-129.1) — height-locked so it can never push content below the fold,
 * placed outside any scroll region so it paints at 120x36 with zero
 * scrolling (defect ④ of premise P-1). */
#map_stats {
    width: 100%;
    height: 1;
    margin-top: 1;
}

#map_stats_body {
    width: 100%;
    height: 1;
    color: $fg-base;
}

#bookmarks_placeholder {
    width: 100%;
    height: auto;
    padding: 2 2;
    color: $fg-base;
}

/* --- Patch Editor + A2B Diff (batch-02 increment 10 / batch-03 increment 9)
 * batch-03 increment 9 makes the Patch Editor functional: a change-list
 * DataTable, name/index/value inputs wired to add/edit/remove, save/load
 * action buttons and a path input, and a neutral empty-state line
 * (LLR-007.1..007.6). LLR-012.3: the A2B Diff stays a static three-column
 * placeholder (range list, hex A, hex B) with constant sample rows and a
 * PLACEHOLDER caption — no second-file load path, no diff computation.
 * Both are purely presentational on the Calm Dark token set.
 */
#ab_diff_panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

/* Docked button rows / groups — siblings of the body, so they sit outside its
 * scroll and are reachable by scrolling the window into view (HLR-064). */
.patch-docked-row,
.patch-docked-group {
    width: 100%;
    height: auto;
    padding: 0 1;
}

/* --- Chip buttons (batch-48, HLR-076 / LLR-076.1) — the batch-47 CARRY -----
 * Batch-47 deferred this family for want of a consumer, which was correct: the
 * only chip-like rule then was `.issue-code-chip` (:1023), which styles a
 * `Label`, NOT a `Button` — it is the visual PRECEDENT for the compact/bold/
 * colour-cued idiom, not a rule this can reuse. The Patch Editor's docked rows
 * are that consumer: each button-bearing container carries a `patch-chip-*`
 * GROUP class and each `Button` carries `patch-chip`, so the container supplies
 * the hue (what this group of buttons DOES) and the button supplies the chip
 * shape.
 *
 * ⚠ C-30 CONTAINMENT (LLR-076.1) — this scoping is the ENTIRE basis of the
 * "C-30 = N/A for batch-48" verdict (§2.4-8). EVERY rule below is rooted at
 * `#patch_editor_panel`, so nothing outside the Patch Editor can match it:
 * no bare `Button` selector, no unscoped class rule. AT-076b is the falsifying
 * leak probe; if a rule here ever needs to go app-wide, C-30 RE-BINDS and the
 * chip increment must be re-sequenced LAST.
 *
 * Textual's `Button` renders 3 rows tall (`border-top`/`border-bottom: tall`
 * in its DEFAULT_CSS) and reserves `min-width: 16`. A chip collapses that to a
 * single row of bold coloured text, so the family SPENDS NO rows against the
 * measured ~5-row @80x24 docked budget (LLR-076.4 / FOLD-8
 * reachable-under-scroll). `:disabled` (`text-opacity: 0.6`) and `:focus`
 * (`text-style`) are text-based in Button's own DEFAULT_CSS, so both cues
 * survive `border: none` unaided — no rule is added for them. */
#patch_editor_panel .patch-chip {
    height: 1;
    min-width: 8;
    border: none;
    text-style: bold;
}

/* The three colour groups (LLR-076.2). Blue is `$accent-calm`, the ONE declared
 * accent var (:26). Purple/cyan have NO var — the Calm Dark token set declares
 * only the accent + the structural navy steps (:21-31) — so they carry the
 * literal `insight_style` hex with its constant NAMED in the comment, which is
 * this file's established idiom for non-accent palette hues (`.sev-*` :529-547,
 * `.band-*` :566).
 *
 * ⚠ THE CHIP FAMILY IS NON-VERDICT BY CONSTRUCTION (Inc-2b, operator ruling
 * 2026-07-16). GREEN / YELLOW / RED are RESERVED for VERDICTS inside this panel
 * and the family may claim none of them. Inc-2 shipped apply=GREEN and
 * checks=YELLOW; Inc-3 lands the per-check verdict glyphs in the SAME panel
 * (`_GLYPH_STYLE` = ✓ GREEN / ✗ RED / ◐ YELLOW), so those two hues would have
 * meant BOTH "this button applies / runs checks" AND "this check passed /
 * partially passed" on one screen. THE VERDICT CUE MUST NEVER BE AMBIGUOUS — it
 * is what tells an analyst whether a patch passed — so the FUNCTION cue yields
 * and moves to non-verdict hues. §6.5 Amendment F (batch-47: yellow ≡ warning
 * app-wide) is one batch old and stays intact; this change protects it.
 *
 * The triple below is FORCED, not preferred: of `insight_style`'s non-verdict
 * hues, DGRAY is itself a cue (grey ≡ "not yet checked", REQUIREMENTS.md §6.5),
 * LBLUE is HILITE's hue desaturated (both ~223°, so not distinguishable as a
 * group), and LABEL/VALUE are body-text greys. HILITE (~223°) / PURPLE (~274°)
 * / CYAN (~199°) are the only three that resolve DISTINCTLY — which is what
 * AT-076a asserts. CYAN is also `.sev-info` (:541), but this panel mounts no
 * `sev-*` consumer (`PatchEditorPanel` carries none; the `sev-info` status line
 * lives in the SEPARATE `AbDiffPanel`), so no in-panel hue collides.
 *
 * These remain deliberately NOT `sev-*` CLASSES: a chip group is a FUNCTION cue
 * (what the button does), not a severity verdict, and `color_policy` stays the
 * single source of truth for severity. Reusing the class would let a severity
 * retune silently retint these buttons. (Inc-2 rejected the class and then
 * reused the HUE anyway — that was the gap Inc-2b closes.) */
#patch_editor_panel .patch-chip-entry .patch-chip {
    color: $accent-calm;
}

#patch_editor_panel .patch-chip-apply .patch-chip {
    color: #b565f3;              /* insight_style.PURPLE */
}

#patch_editor_panel .patch-chip-checks .patch-chip {
    color: #7dd3fc;              /* insight_style.CYAN */
}

/* A↔B Diff panel (batch-09 I4, HLR-005): the inline image-pair selection
 * rows, the action row, the panel status line and the three result columns.
 * The status line's colour comes from the `sev-*` classes (the single
 * `color_policy` source of truth, LLR-005.2); the rules below only set
 * layout. */
/* HLR-125 / LLR-125.1 (batch-78 Inc-1): the three control rows compact from
 * three rendered rows each to ONE. `height: auto` resolved to 3 because every
 * child carries Textual's default `tall` border (Input, Button, Select's
 * SelectCurrent) and the field Label carried a 1-row top padding — 9 rows of
 * chrome out of an `#ab_diff_panel` measuring 11 at 120x30, which left
 * `#diff_status` and `#diff_columns` with a clipped visible height of ZERO.
 * The `margin-bottom: 1` separators are deliberately KEPT: the requirement is
 * "one rendered row per control row", not "reclaim every reclaimable row".
 * All but one of these are id-scoped on purpose (C13) — `styles.tcss` id
 * selectors outrank a widget's `DEFAULT_CSS`, which is what makes a CSS-only
 * compaction possible without touching `screens_directionb.py`'s compose. The
 * exception is `.diff-field-label`, a CLASS selector: it is applied to exactly
 * the two `Label`s in these rows (`screens_directionb.py:6739`, `:6745`) and
 * to nothing else in the app, so its blast radius is those two widgets. */
#diff_select_row_a,
#diff_select_row_b,
#diff_action_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.diff-field-label {
    width: 3;
    height: 1;
    color: $fg-base;
    padding: 0 1;
}

#diff_select_a,
#diff_select_b {
    height: 1;
}

#diff_select_a SelectCurrent,
#diff_select_b SelectCurrent {
    height: 1;
    border: none;
    padding: 0 1 0 0;
}

#diff_path_a,
#diff_path_b,
#diff_report_dest {
    height: 1;
    border: none;
    padding: 0 1;
}

#diff_compare_button,
#diff_report_button {
    height: 1;
    border: none;
    margin-right: 1;
}

#diff_status {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

#diff_columns {
    width: 100%;
    height: 1fr;
}

/* US-020a: Issues Report split — the issues list (left) beside a hex pane
 * (right) that shows the bytes at the selected issue's address. Mirrors the
 * #diff_columns horizontal split. */
/* batch-49 (LLR-082.1/.2): the severity-distribution strip — one always-visible
 * line above the grouped list carrying the coloured Errors/Warnings/Info counts
 * + micro-bars. Author text only (no file-derived content reaches it). */
#issues_severity_strip {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#issues_columns {
    layout: horizontal;
    width: 100%;
    height: 1fr;
}

/* US-039: left slot holds the grouped-dense view (the SOLE visible Issues
 * surface). The legacy DataTable is a stacked-but-hidden compatibility
 * surface (see below), so the grouped panel fills the whole stack. batch-49
 * (LLR-082.4): the frame + author border-title/subtitle live on this stack
 * (dolphie `.db-pane` idiom) — the inner grouped panel drops its own border so
 * there is a single titled frame, not two. */
#issues_list_stack {
    layout: vertical;
    width: 2fr;
    height: 100%;
    border: round $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
    border-subtitle-color: #969aad;
}

#validation_issues_groups {
    width: 100%;
    height: 100%;
}

/* US-039 grouped-dense rows: a bold per-severity group header, then compact
 * issue rows each carrying a fixed-width code chip beside the detail span.
 * Severity colour comes from the frozen `sev-*` classes (color_policy) applied
 * on the header / chip / row — no hex is set here. */
.issue-group-header {
    width: 100%;
    height: auto;
    text-style: bold;
    padding: 1 1 0 1;
}

.issue-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    padding: 0 1;
}

.issue-row:focus {
    text-style: reverse;
}

.issue-code-chip {
    width: auto;
    min-width: 16;
    height: auto;
    text-style: bold;
    margin-right: 1;
}

.issue-detail {
    width: 1fr;
    height: auto;
}

/* Related artifacts, restored to the grouped row (LLR-043.R8). Muted + width:auto
 * so it trails the 1fr detail span without forcing horizontal overflow. */
.issue-related {
    width: auto;
    height: auto;
    color: #6b7280;
    margin-left: 1;
}

.issues-empty-note,
.issues-truncation-note {
    width: 100%;
    height: auto;
    padding: 1;
}

/* batch-49 (LLR-082.4): author border-title on the existing round frame. */
#issues_hex_pane {
    width: 1fr;
    height: 100%;
    border: round $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
}

/* ---------------------------------------------------------------------------
 * batch-49 (LLR-083.5 / LLR-084.*): the dedicated CHECKS rail screen
 * (`#screen_checks`) — a read-only mirror of the last check run. Mirrors the
 * `#issues_*` / `.issue-*` blocks above: an aggregate strip over a grouped
 * list beside a titled hex peek. Severity colour comes from the frozen `sev-*`
 * classes (color_policy) applied on the header / rows — no hex is set here.
 * ------------------------------------------------------------------------- */
#checks_content {
    width: 100%;
    height: 1fr;
}

#checks_content.hidden {
    display: none;
}

#checks_aggregate_strip {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#checks_columns {
    layout: horizontal;
    width: 100%;
    height: 1fr;
}

/* The grouped-dense panel carries the author border-title/subtitle frame
 * directly (there is no wrapping list-stack as on the Issues screen). */
#checks_grouped {
    width: 2fr;
    height: 100%;
    border: round $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
    border-subtitle-color: #969aad;
}

#checks_hex_pane {
    width: 1fr;
    height: 100%;
    border: round $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
}

.check-group-header {
    width: 100%;
    height: auto;
    text-style: bold;
    padding: 1 1 0 1;
}

.check-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    padding: 0 1;
}

.check-row:focus {
    text-style: reverse;
}

.check-detail {
    width: 1fr;
    height: auto;
}

/* The file-derived linkage symbol rides its own muted, width:auto cell so it
 * trails the 1fr detail span without forcing horizontal overflow. */
.check-linkage {
    width: auto;
    height: auto;
    color: #6b7280;
    margin-left: 1;
}

.checks-empty-note,
.checks-truncation-note,
.checks-no-run-note {
    width: 100%;
    height: auto;
    padding: 1;
}

/* Patch Editor — the batch-07 consolidated v2 panel: ONE change-flow section
 * (entries DataTable, both-kind entry inputs, document control row, the
 * persistent declaration-fault area, the save-back prompt row and the check
 * results). Rules folded here from the E3a `PatchEditorPanel.DEFAULT_CSS`
 * (visual parity preserved) when E3b retired the batch-03/04 ids' rules. */
.patch-section-title {
    width: 100%;
    height: auto;
    color: $fg-base;
    text-style: bold;
    padding: 0 1;
}

.patch-field-label {
    color: $fg-base;
    padding: 0 1;
}

/* batch-48 (code-review F4): a label+VALUE stat line, not a field label.
 * `#patch_variant_scope_line` borrowed `.patch-field-label`, but it renders an
 * `insight_style.label_value` pair which sets BOTH colours on the `Text`
 * itself — so `.patch-field-label`'s `color: $fg-base` is inert there and only
 * its padding was ever wanted. Its own class says exactly that, and nothing
 * more. Scoped under `#patch_editor_panel` for the same C-30 containment as
 * the chip family above. */
#patch_editor_panel .patch-stat-line {
    padding: 0 1;
}

/* HLR-124 / LLR-124.2-.4 (batch-78 Inc-5) — the three width/height regimes.
 *
 * The shipped three-way `1fr` split gave each of the run list and the two hex
 * windows a third of the pane: 26 cells at 120 and 39 at 160, against a hex row
 * `hexview.render_hex_view` emits at **79**. Every hex row wrapped at every
 * supported width. The horizontal budget only ever fits ONE window (at 160 the
 * widest supported terminal, `#diff_columns` has 132 content cells), so the two
 * windows STACK inside `#diff_window_column` and share the vertical axis
 * instead.
 *
 * Regime classes live on `#ab_diff_panel` and are set by
 * `AbDiffPanel.apply_regime` (LLR-124.1). They are deliberately NOT the
 * existing `width-narrow` class, which is toggled at 120 and read by 11 rules
 * across workspace, map, patch and rail.
 *
 *   .diff-wide      W >= 139  run list BESIDE the window column
 *   .diff-fallback  94 <= W < 139 and H >= 28  full-width window column; the
 *                   run list is an overlay on `f`, costing zero permanent
 *                   columns and zero permanent rows
 *   .diff-notice    W < 94 or H < 28  an explicit notice naming every
 *                   unsatisfied axis, instead of a silently empty results area
 */
#diff_range_list,
#diff_hex_a,
#diff_hex_b {
    width: 1fr;
    height: 100%;
    border: round $rule;
    background: $bg-panel;
    color: $fg-base;
    padding: 1;
    margin-right: 1;
}

#diff_window_column {
    width: 1fr;
    height: 100%;
}

/* Stacked, so each window's height is a share of the pane rather than all of
 * it. `1fr` each rather than `50%` so an odd row count is not lost. */
#diff_hex_a,
#diff_hex_b {
    width: 100%;
    height: 1fr;
}

/* The notice is displayed only in the notice regime. */
#diff_size_notice {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1;
}

#ab_diff_panel.diff-notice #diff_columns {
    display: none;
}

#ab_diff_panel.diff-notice #diff_size_notice {
    display: block;
}

/* Wide (LLR-124.2): a fixed run-list column beside the window column. The CSS
 * `width` is the BORDER box, so 26 is 22 content cells — the list width the
 * `L <= C - 89` bound is derived for, and the reason `_DIFF_WIDE_MIN` is 139
 * rather than 135 (an 18-content list fits at 135). */
#ab_diff_panel.diff-wide #diff_range_list {
    width: 26;
}

/* Fallback (LLR-124.3): the window column takes the full content width and the
 * run list reserves nothing. `layers` puts the overlay on its own layout pass
 * over the same region, so opening it does not resize or re-wrap the window
 * underneath — "without permanently reserving columns or rows" is satisfied by
 * construction rather than by a width that happens to be small.
 *
 * The windows lose their border and vertical padding here, and that is the
 * whole reason the fallback regime can deliver anything at 120x30: the pane has
 * 6 rows there and two bordered boxes spend 8 of them on chrome. Horizontal
 * padding is kept — 92 - 2 = 90 content cells, still well clear of 79. */
#ab_diff_panel.diff-fallback #diff_columns {
    layers: base runs;
}

#ab_diff_panel.diff-fallback #diff_window_column {
    layer: base;
}

#ab_diff_panel.diff-fallback #diff_hex_a,
#ab_diff_panel.diff-fallback #diff_hex_b {
    border: none;
    padding: 0 1;
    margin-right: 0;
}

/* The overlay drops its border and vertical padding for the same reason the
 * windows do: at 120x30 the pane is 6 rows and a bordered box spends 4 of them,
 * leaving a list with two content rows — or, before the command bar goes at
 * Inc-10, with ZERO, which is an overlay the operator cannot read or focus. */
#ab_diff_panel.diff-fallback #diff_range_list {
    display: none;
    layer: runs;
    width: 32;
    height: 100%;
    border: none;
    padding: 0 1;
    margin-right: 0;
}

#ab_diff_panel.diff-fallback.runs-open #diff_range_list {
    display: block;
}

/* --- Calm Dark modal re-skin (batch-02 increment 8, LLR-015.1) -----------
 * Shared rules for the three Load / Save / Load-Project modals in
 * `screens.py` (the only `ModalScreen` subclasses in the app). Each modal's
 * `Container` carries the `.modal-dialog` class (and keeps the legacy
 * `#load_dialog` id), so all three pick up the single Calm Dark accent
 * border, panel surface and foreground tone from the token set above — no
 * hard-coded hex color, no second accent, no light variant (TC-033
 * checklist). These rules live here, not in a per-screen `DEFAULT_CSS`,
 * because the Calm Dark `$bg-*` / `$fg-*` / `$rule` token variables only
 * resolve inside the app-level stylesheet. This is a visual re-skin only;
 * modal behavior, `validate_project_files` and the `.s19tool/` workarea
 * layout are untouched (LLR-015.2).
 */
ModalScreen {
    align: center middle;
    background: $bg-base 70%;
}

.modal-dialog,
#load_dialog {
    border: round $accent-calm;
    background: $bg-panel;
    color: $fg-base;
    padding: 1 2;
    width: 70%;
    height: auto;
}

.modal-title {
    color: $accent-calm;
    text-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}

/* --- Change-set JSON popup (batch-37, US-064b / LLR-064b.1/.3) ----------
 * Reuses the shared `.modal-dialog` box model. Caps the dialog height and
 * lets the editor `TextArea` fill the remaining budget (`height: 1fr`) so the
 * operator gets a readable multi-line JSON editor — the affordance the
 * height-starved in-panel `#patch_paste_text` box cannot give at 80x24
 * (batch-36 F-01). N_w visible editable lines are pilot-measured at 80x24 and
 * 120x30 (LLR-064b.3, C-23). */
#changeset_json_dialog {
    height: 90%;
}

#changeset_json_text {
    height: 1fr;
}

/* --- Legend modal (batch-18, LLR-023.1) ---------------------------------
 * Reuses the shared `.modal-dialog` token styling; caps the dialog height
 * and scrolls the body so the full A2L/MAC/Issues legend fits the 80- and
 * 120-col regimes (C-13). The per-row `sev-*` classes colour the rows. */
/* batch-72 LLR-072-5.2: the body is a two-pane wrapper, so the scroll context
 * moves OFF `#legend_body` (`overflow: hidden`) and ONTO the panes — three
 * nested scroll contexts otherwise. Measured at 120x30 (00-measurements M-2):
 * dialog 113 cols, content 107 after 6 cols of modal chrome, card pane 64,
 * key pane 43, body 15 rows, `#legend_key_pane.max_scroll_y == 0`. */
#legend_dialog {
    height: 90%;
    width: 96%;
}

#legend_body {
    height: 1fr;
    overflow: hidden;
}

#legend_card_pane {
    width: 3fr;
    height: 1fr;
    overflow-y: auto;
}

#legend_key_pane {
    width: 2fr;
    height: 1fr;
    overflow-y: auto;
}

/* batch-72 LLR-072-6.2 — the floor regime (< 120 cols), keyed on the
 * `legend-narrow` class `LegendScreen._apply_width_regime` toggles. EVERY rule
 * is prefixed `#legend_dialog.legend-narrow`: unprefixed they would have equal
 * specificity to the wide rules above and later source order, so they would win
 * in BOTH regimes and push the key pane outside `#legend_body`. The pane ORDER
 * (key above card) is document order, produced by `move_child` — textual 8.2.8
 * has no CSS ordering property. `height: auto` on the key pane is excluded by
 * measurement (00-measurements M-3): it starves the card to 1 row and overflows
 * the body. Measured at 80x24: key h=4, card h=5. */
#legend_dialog.legend-narrow #legend_body {
    layout: vertical;
}

#legend_dialog.legend-narrow #legend_key_pane {
    width: 100%;
    height: 1fr;
}

#legend_dialog.legend-narrow #legend_card_pane {
    width: 100%;
    height: 1fr;
}

.legend-artifact {
    text-style: bold;
    margin-top: 1;
}

/* N8 example-card lines (LLR-N8-6.2): weight / dim / layout ONLY — never a
 * `sev-*` or `band-*` colour, so an annotated card line cannot be mistaken for a
 * colour-key row. Disjoint from `.sev-*` (:636-660) and `.band-*` (:665-679). */
.legend-card-sub {
    text-style: bold;
    margin-top: 1;
}

.legend-card-line {
    margin-left: 1;
}

.legend-card-caption {
    text-style: dim;
    margin-left: 1;
}

/* --- batch-93 inc-003 (HLR-132): the map spec-sheet dialog ----------------
 * The map view's `k`-legend is the spec sheet: four grouped bordered boxes
 * in ONE full-width scrolling column (LegendScreen.compose's map branch) —
 * not the two-pane card/key body. The chrome is deliberately full-bleed:
 * WIDTH BUDGET, measured at the 80x24 floor on textual 8.2.8 — screen 78 ->
 * dialog 78 (100%) -> content 76 after the dialog border (2) -> sheet pane 74
 * after the vertical-scrollbar gutter (2; the sheet always scrolls at the
 * floor) -> box interior 72 after the box border (2). The contract's pinned
 * Keys line measures 71 cells (LLR-132.1), so it fits the floor interior
 * with ONE column of slack — under the stock 96% dialog + 2-col side padding
 * (interior ~64) it cannot, so `.legend-sheet` carries its own chrome and
 * the boxes take ZERO padding: every interior column is spoken for. */
#legend_dialog.legend-sheet {
    width: 100%;
    padding: 1 0;
}

#legend_dialog.legend-sheet #legend_body {
    height: 1fr;
}

/* The grouped boxes echo the map's own `.db-pane` chrome tokens (LLR-125.1's
 * idiom) so the sheet reads as the map's reference card. */
#legend_dialog.legend-sheet .legend-sheet-box {
    border: tall $rule;
    border-title-color: $accent-calm;
    border-title-background: $bg-panel;
    background: $bg-panel;
    height: auto;
    margin-top: 1;
}

/* Meaning lines (the annotation under each rendered sample) sit dim — the
 * LLR-N8-6.2 weight/dim-only law for card lines, kept for the sheet: a
 * meaning line must never read as a colour-key row. */
#legend_dialog.legend-sheet .legend-sheet-meaning {
    text-style: dim;
}

/* The entropy-viewer modal (batch-26 `#entropy_*` / `.entropy-*` rules) was
 * removed in batch-45 Inc-5 — its function moved into the always-visible
 * Memory-Map band view (R-TUI-060/061/062). */

.modal-buttons {
    layout: horizontal;
    height: auto;
    align-horizontal: right;
    padding-top: 1;
    dock: bottom;
}

.modal-buttons Button {
    margin-left: 2;
}

/* The confirm button carries the single Calm Dark accent so the primary
 * action reads against the panel surface without introducing a second hue. */
.modal-confirm {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold;
}

.modal-dialog Input {
    border: round $rule;
    background: $bg-base;
    color: $fg-base;
}

.modal-dialog Input:focus {
    border: round $accent-calm;
}

#project_list, #variant_list {
    border: round $rule;
    background: $bg-base;
    height: 10;
}

/* --- Save-project per-variant assignment lists (batch-16 LLR-017.3) --------
 * One SelectionList per variant + a project-wide batch list, each height-
 * capped so a long candidate set scrolls inside the modal rather than
 * overflowing it. Colors resolve through the shared Calm Dark tokens. */
.assign-list {
    border: round $rule;
    background: $bg-base;
    height: 6;
    margin-bottom: 1;
}

/* --- Report viewer modal (batch-07 E8, LLR-008.1/008.5) --------------------
 * Listing strip on top, scrollable Markdown render area filling the rest,
 * generation row (context-bytes input + buttons) docked at the bottom via
 * the shared `.modal-buttons` rule. Colors all resolve through the shared
 * Calm Dark modal tokens — no new hue. */
#report_dialog {
    height: 80%;
}

#report_list {
    border: round $rule;
    background: $bg-base;
    height: 8;
    margin-bottom: 1;
}

#report_empty_state {
    color: $fg-base;
    padding: 1 1;
    height: auto;
    margin-bottom: 1;
}

#report_markdown_scroll {
    border: round $rule;
    background: $bg-base;
    height: 1fr;
}

#report_context_bytes {
    width: 12;
}

/* Declared-region input (batch-19, LLR-024.3). Small fixed height so the
 * `1fr` markdown scroll above it absorbs the addition and the dialog stays
 * within its 80% height at the 80- and 120-col regimes (C-13). */
#report_declared_regions {
    border: round $rule;
    background: $bg-base;
    height: 5;
    margin-bottom: 1;
}

/* Report-filter selector row (batch-35 US-056, LLR-056.2/056.5).
 * C-13.1 ladder record: rung 1 (1fr absorber) FAILED at the 80x24 floor —
 * the dialog's in-flow content already ends exactly at the dialog bottom
 * pre-batch (measured deficit 4 rows), so rung 2 (-2 rows) cannot cover
 * it. Rung 3 applied: the selector joins the DOCKED bottom control region
 * (0 added flow rows), as a second docked line above `.modal-buttons`
 * because a single-line fold is horizontally infeasible at 80 cols (five
 * widgets exceed the 48-cell dialog interior). */
#report_filter_row {
    width: 100%;
    height: 3;
    dock: bottom;
    /* Same-edge docks OVERLAY in textual 8.2.8 (measured) — offset by the
     * buttons row's realized height (4: padding-top 1 + button chrome 3)
     * so the selector stacks as the docked region's second line. */
    margin-bottom: 4;
}

#report_filter_label {
    width: 8;
    padding: 1 1 0 0;
    color: $fg-base;
}

#report_filter_select {
    width: 40%;
}

#report_filter_path {
    width: 1fr;
}

/* --- Operations modal (batch-08 I3, LLR-004.1/004.3) -----------------------
 * Operation list on top, one-line status/notes strip, scrollable hex render
 * of the result image filling the rest, Execute/Close docked at the bottom
 * via the shared `.modal-buttons` rule. Colors all resolve through the
 * shared Calm Dark modal tokens — no new hue. */
#operations_dialog {
    height: 80%;
}

#operations_list {
    border: round $rule;
    background: $bg-base;
    height: 6;
    margin-bottom: 1;
}

#operation_result_status {
    color: $fg-base;
    padding: 0 1;
    height: auto;
    margin-bottom: 1;
}

#operation_result_hex_scroll {
    border: round $rule;
    background: $bg-base;
    height: 1fr;
}

#files_title, #sections_title, #hex_title, #a2l_title, #ws_stats_title, #a2l_tags_title, #alt_hex_title, #alt_actions_title {
    text-align: center;
    width: 100%;
    background: $accent-calm;
    color: $bg-base;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}

/* --- Activity rail (batch-02 increment 3, LLR-001.1/001.2/001.3) ----------
 * `Rail` is the vertical 8-item navigation column mounted in `#rail_slot`.
 * Each `RailItem` is one row; the active item carries `.-active`, marked
 * with the single Calm Dark accent (`$accent-calm`) — the LLR-001.2
 * single-active-marker invariant. The wide-regime rail is 22 columns; the
 * `<120`-column collapsed (icon-only) regime is handled below.
 */
#activity_rail {
    width: 22;
    height: 100%;
    background: $bg-panel;
    border-right: solid $rule;
    padding: 1 0;
}

.rail-item {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $fg-base;
    border-left: vkey $bg-panel;
}

.rail-item:hover {
    background: $bg-base;
}

.rail-item.-active {
    color: $accent-calm;
    background: $bg-base;
    border-left: vkey $accent-calm;
    text-style: bold;
}

/* --- Two-regime width layout (LLR-007.1 / CV-02) -------------------------
 * `width-narrow` is toggled by `on_resize` below the 120-column breakpoint
 * on both `#workspace_shell` and `#workspace_body` (see `_apply_width_regime`).
 * The rail-collapse rule is keyed on `#workspace_shell` because `#rail_slot`
 * is a sibling of `#workspace_body`, not a descendant of it. In the narrow
 * regime the activity rail collapses to an icon-only fixed width (4 columns,
 * within the 4±1 tolerance of LLR-001.1 CV-02 / LLR-008.1); the single active
 * marker is preserved. The proportional per-screen pane widths
 * (LLR-008.1 / LLR-009.1 / LLR-010.1) are keyed on `#workspace_body`.
 */
#workspace_shell.width-narrow #rail_slot,
#workspace_shell.width-narrow #activity_rail {
    width: 4;
}

#workspace_shell.width-narrow .rail-item {
    padding: 0;
}

/* --- Flow Builder — Direction A "Pipeline Ledger" (batch-51, R-TUI-088) ----
 * The run-result pane: a flow-status banner, one vertical block-node per
 * BlockResult with a `sev-*` status gutter, an `N-1` bordered separator
 * between nodes (tone `$rule`, LLR-088.3), the single memory ribbon
 * (LLR-088.4 / AMD-1), and the written-path lines. Colour flows through the
 * frozen `.sev-*` classes (styles.tcss:529-546); this block owns only layout.
 * batch-97 Inc-5: the `#flow_gating` and `#flow_result` rules moved into the
 * scoped batch-97 flow_builder section at the end of this file.
 */
.flow-banner {
    text-style: bold;
    width: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.flow-node {
    height: auto;
    padding: 0 0 0 1;
}

.flow-node-head {
    text-style: bold;
}

.flow-node-summary {
    padding-left: 2;
}

.flow-finding, .flow-diag {
    padding-left: 4;
}

/* Block separator (LLR-088.3): a one-cell bordered rule of tone `$rule`
 * between consecutive nodes — the border IS the divider (no `Rule` widget). */
.flow-sep {
    height: 1;
    border-top: solid $rule;
    margin: 0 1;
}

.flow-ribbon {
    height: 1;
    margin-top: 1;
}

.flow-ribbon-cap {
    height: 1;
}

.flow-wrote, .flow-run-diag {
    padding-left: 1;
}

/* --- Flow persistence (batch-53 FB-P1): name strip, save note, quarantine ---
 * The name strip is the dirty/saved state cue (glyph-primary `●`/`✓`, C-10);
 * colour flows through the frozen `.sev-*` classes (secondary). The quarantine
 * card is a bordered `.sev-error` box mounted into `#flow_result` on a rejected
 * load — every file-derived line is a markup-safe `Static` (C-17). Layout only.
 */
.flow-name-strip {
    text-style: bold;
    width: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.flow-save-note {
    text-style: bold;
    width: auto;
    padding: 0 1;
}

.flow-quarantine {
    height: auto;
    border: round $rule;
    padding: 0 1;
}

.flow-quarantine-head {
    text-style: bold;
}

.flow-quarantine-line {
    padding-left: 2;
}

.flow-quarantine-foot {
    text-style: italic;
    margin-top: 1;
}

/* Sanitiser hint under a modal input (batch-53 SaveFlowScreen). */
.modal-hint {
    color: #969aad;
    padding: 0 1;
}

/* --- CRC Designer "coverage-first bench" (batch-59) ----------------------
 * The `crc-*` classes were UNDEFINED before this batch, so the panel fell back
 * to Textual's default vertical stacking (the flat form). These rules supply
 * the Variant-B bench: a hero row (2fr coverage window + 1fr verdict/warnings)
 * over a 3-column parameter grid, both reflowing to a vertical stack under the
 * existing `#workspace_body.width-narrow` cascade (LLR-L2.2 / L2.4 / L3.1).
 * Colors bind theme tokens (`$accent-calm` accent, `$rule` borders, `$bg-panel`
 * surfaces) — no hardcoded prototype hexes.
 */
#crc_designer_panel {
    padding: 0 1;
}

#crc_designer_help {
    color: #969aad;
    margin-bottom: 1;
}

.crc-field-group {
    border: round $rule;
    background: $bg-panel;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

.crc-group-title {
    color: $accent-calm;
    text-style: bold;
}

/* R3: rows center 1-tall labels on 3-tall selects (kills the label/input
 * vertical off-by-one). */
.crc-field-row {
    height: auto;
    align-vertical: middle;
}

/* R2: a fixed 13-col right-aligned dim label gutter — every input starts on one
 * column, labels right-align toward their value (dim so values dominate). */
.crc-field-label {
    width: 13;
    text-align: right;
    padding-right: 1;
    color: #969aad;
}

/* R9: compact borderless 1-tall inputs — the focus cue is a background shift,
 * not a 3-tall border (halves the per-row chrome). */
.crc-field-input {
    border: none;
    height: 1;
    background: $background;
    padding: 0 1;
}
.crc-field-input:focus {
    background: $rule;
}
.crc-field-switch {
    border: none;
    height: 1;
}

/* batch-72 LLR-072-1.1: the per-control sub-label inside a paired row (the
 * `in` / `out` reflection toggles, the Self-test reference vector). Content-
 * width so it never claims the 13-col label gutter, and it renders BETWEEN the
 * two switches — that separation is the point (HLR-072-1 / HLR-072-3). */
.crc-field-sublabel {
    width: auto;
    padding-right: 1;
    color: #969aad;
}

/* Selects keep their overlay chrome (bordered, 3-tall) but stop eating the row. */
#crc_designer_panel Select {
    width: 1fr;
    max-width: 34;
}

/* R9: 1-tall compact buttons — Save + Load fit side-by-side in a bench column. */
#crc_designer_panel Button {
    border: none;
    height: 1;
    min-width: 8;
    margin-right: 2;
    background: $rule;
    color: $accent-calm;
}

/* R7: the Warnings tile — ⚠ lines / ✓ none carry their own Text colour, so the
 * class stays colour-neutral. */
.crc-warnings {
    height: auto;
}

/* Hero row: the coverage window (2fr) beside the verdict/warnings column (1fr). */
#crc_hero_row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

#crc_coverage_window {
    width: 2fr;
    height: auto;
    min-height: 5;
    max-height: 8;
    padding: 1 2;
    border: round $accent-calm;
    background: $bg-panel;
    color: $fg-base;
}

#crc_top_right {
    width: 1fr;
    height: auto;
    padding-left: 1;
}

/* The 3-column parameter bench below the hero row. */
#crc_bench {
    layout: horizontal;
    height: auto;
}

#crc_bench_c1 {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

#crc_bench_c2 {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#crc_bench_c3 {
    width: 1fr;
    height: auto;
    padding-left: 1;
}

/* R6: the JSON preview is a full-width strip below the bench — wide flat text
 * gets the wide surface, so the min-height relaxes (no longer a tall column tile). */
#crc_json_preview_group {
    width: 100%;
    min-height: 6;
}

#crc_json_preview {
    min-height: 4;
}

/* width-narrow reflow: at the 80x24 floor the hero row and the bench both stack
 * vertically so the 2fr window and the 3 columns never crush (LLR-L2.2/L2.4). */
#workspace_body.width-narrow #crc_hero_row {
    layout: vertical;
}

/* R8: at the 80x24 floor stack full-width AND cap the hero so the verdict lands
 * on screen 1 — drop the padding WITH the cap (2 border + 2 pad = 4 rows = zero
 * content, C-29). */
#workspace_body.width-narrow #crc_coverage_window {
    width: 100%;
    min-height: 3;
    max-height: 4;
    padding: 0 1;
}

#workspace_body.width-narrow #crc_top_right {
    width: 100%;
    padding-left: 0;
}

#workspace_body.width-narrow #crc_bench {
    layout: vertical;
}

#workspace_body.width-narrow #crc_bench_c1,
#workspace_body.width-narrow #crc_bench_c2,
#workspace_body.width-narrow #crc_bench_c3 {
    width: 100%;
    padding: 0;
}

/* R8: hide the redundant help line at the floor (the title + Legend already
 * carry the "preview-only" cue). */
#workspace_body.width-narrow #crc_designer_help {
    display: none;
}


/* --- Split / Join / Export (batch-95 change 4, HLR-135) -------------------
 * The graft chassis: V1's cockpit (the range table left, the .db-pane
 * PREVIEW right) + V2's deltas — the pane widens to 58 at the MEASURED
 * >=118-column regime (the band gets 54 cells) and split mode gains the
 * per-file gantt under the union map (hidden at the floor and outside
 * 1..6 files by the window's own show/hide). The two-regime thresholds
 * read the measured screen exactly like the batch-93 frame discipline;
 * every new id's styles live HERE (LLR-135.1's 0-hand-typed-styles law —
 * the visor's per-class hues are band DATA, code-side Rich styles like the
 * shipped Memory Map band idiom, not widget CSS). */
#sje_body {
    layout: horizontal;
    height: 1fr;
}

#sje_left {
    width: 1fr;
    height: 100%;
    layout: vertical;
    padding-right: 1;
}

#sje_right {
    width: 40;
    height: 100%;
    border: tall $rule;
    background: $bg-panel;
    /* The .db-pane idiom ships padding: 1; here it is zeroed so the wide
     * regime's band measures the contracted 54 cells (58 - 2 border - 2
     * child padding). The spacing rows ride margin/padding-top instead. */
    padding: 0;
}

#sje_right:focus-within {
    border: tall $accent-calm;
}

#sje_right > * {
    padding: 0 1;
}

#sje_table {
    height: 1fr;
    min-height: 4;
    overflow-y: auto;
    border-top: solid $rule;
    border-bottom: solid $rule;
}

#sje_table:focus {
    border-top: solid $accent-calm;
    border-bottom: solid $accent-calm;
}

#sje_manual {
    height: 3;
    border: solid $rule;
}

#sje_band {
    margin-top: 1;
}

#sje_files_wrap {
    height: auto;
    margin-top: 1;
}

#sje_files {
    height: auto;
}

#sje_stats {
    padding-top: 1;
    height: auto;
    min-height: 2;
}

#sje_summary {
    margin-top: 1;
    max-height: 3;
}

.sje-chips {
    height: 1;
}

.sje-legend {
    height: 1;
}

.sje-outlabel {
    height: 1;
}

.sje-band {
    height: 1;
}

.sje-ruler {
    height: 1;
}

#sje_export {
    height: 1;
    min-width: 14;
    border: none;
    background: #1a2340;
    color: $accent-calm;
    margin: 0 1;
}

#sje_export:hover,
#sje_export:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold;
}

/* The two-regime reflow (LLR-135.3): the floor narrows the pane to 30 and
 * hides the gantt wrap + the naming row (the sample lives in the outlabel);
 * the wide regime (MEASURED >= 118 cols) widens the pane to 58 so the band
 * gets 54 cells. Rules are scoped to #screen_split_join so the class names
 * can never leak onto another surface. */
#screen_split_join.narrow #sje_right {
    width: 30;
}

#screen_split_join.narrow #sje_files_wrap {
    display: none;
}

#screen_split_join.narrow #sje_naming {
    display: none;
}

/* The floor hides the summary too (the outlabel + stats already name the
 * selection and the numbers) so the EXPORT button keeps its row — the
 * oracle floor frame shows ^E, and LLR-135.3 wants every control reachable.
 * The stats' separator row is dropped with it (the single state line abuts
 * the ruler). */
#screen_split_join.narrow #sje_summary {
    display: none;
}

#screen_split_join.narrow #sje_stats {
    padding-top: 0;
}

#screen_split_join.wide #sje_right {
    width: 58;
}



/* batch-97 check_editor — the ledger + REPORT FIELDS card (HLR-145, ce_A).
 *
 * ONE scoped section (D23). CSS expresses every split it can: the ledger
 * column takes `1fr`, the card `38%` with a 42-cell floor (the Fields name
 * field keeps >= 24 cells, LLR-145.3), the ledger table `height: 1fr` is the
 * growing region (LLR-149.5), and every row under the two columns is one
 * terminal row with no margin (design §3, Check budget). Python sizes only
 * what CSS cannot: the DataTable column widths and the Fields name field
 * (`check_layout`, D21). The chip rules are rooted at the panel and never
 * name the Patch Editor's chip class (TC-076.1 / AT-076b). Hues are
 * the Calm Dark tokens plus insight_style.GREEN / CYAN / DGRAY, already
 * claimed by the hue census. */
#check_editor_panel {
    width: 100%;
    height: 1fr;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#check_columns {
    height: 1fr;
    min-height: 10;
}

#check_left_column {
    width: 1fr;
    height: 100%;
    border: round $rule;
    border-title-color: #969aad;      /* insight_style.DGRAY */
    border-subtitle-color: #969aad;   /* insight_style.DGRAY */
}

#check_left_column:focus-within,
#check_right_column:focus-within {
    border: round $accent-calm;
}

#check_right_column {
    width: 38%;
    min-width: 42;
    height: 100%;
    padding: 0 1;
    border: round $rule;
    border-title-color: #969aad;      /* insight_style.DGRAY */
}

#check_editor_panel .ce-row {
    height: 1;
}

#check_editor_panel .ce-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: #969aad;                   /* insight_style.DGRAY */
}

#check_param_filter,
#check_mem_address_input,
#check_mem_label_input,
#check_file_name_input {
    width: 1fr;
}

#check_param_table {
    height: 1fr;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#check_full_name_line,
#check_fields_lines,
#check_legend,
#check_status,
#check_apply_hint,
#check_editor_panel .ce-hint {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#check_full_name_line {
    height: 1;
    padding: 0 1;
}

#check_param_controls,
#check_mem_controls,
#check_card_tabs,
#check_spec_file_row,
#check_dock {
    layout: horizontal;
    height: 1;
    padding: 0;
}

#check_editor_panel .ce-hint {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #969aad;                   /* insight_style.DGRAY */
}

#check_card_switcher {
    height: 1fr;
}

#check_pane_fields {
    height: 1fr;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#check_pane_json,
#check_pane_addendum {
    height: 1fr;
    overflow: auto auto;
}

#check_preview,
#check_addendum_preview {
    width: auto;
}

#check_fields_lines {
    height: auto;
}

#check_editor_panel .ce-title {
    height: 1;
    color: #969aad;                   /* insight_style.DGRAY */
}

/* The memory form (operator decision at the Inc-3 gate, LED-…97.14): one
 * spacer row in the card before MEMORY LOCATIONS and one before the status
 * line. The ledger stands beside the card, so neither is a full-width blank
 * panel row (LLR-149.5). */
#check_pane_fields .ce-title,
#check_status {
    margin-top: 1;
}

#check_mem_table {
    height: auto;
    max-height: 7;
    scrollbar-size-vertical: 1;
}

/* One row per field; the labels share one 13-cell column (`Size (bytes)`
 * + 1), the Address and Label inputs take the rest. */
#check_mem_inputs {
    layout: vertical;
    height: 3;
}

#check_mem_size_input {
    width: 6;
}

#check_mem_inputs .ce-label {
    width: 13;
    padding: 0 1 0 0;
}

#check_status {
    width: 100%;
    height: 1;
    padding: 0;
}

#check_results {
    height: auto;
}

#check_spec_file_select {
    width: 30;
    margin-right: 2;
}

#check_actions_row,
#check_actions_row2 {
    layout: horizontal;
    width: auto;
    height: 1;
    padding: 0;
}

#check_apply_ghost,
#check_fields_count {
    width: auto;
    padding: 0 1;
}

#check_apply_ghost {
    color: #969aad;                   /* insight_style.DGRAY */
}

#check_fields_count {
    color: #54efae;                   /* insight_style.GREEN */
}

#check_apply_hint {
    width: 1fr;
    text-align: right;
    color: #969aad;                   /* insight_style.DGRAY */
}

#check_legend {
    height: 1;
    padding: 0 1;
    color: #969aad;                   /* insight_style.DGRAY */
}

/* One-row chips (LLR-145.4): Button's 3-row bordered shape collapsed to one
 * row of bold text. A focused chip reverses (LLR-145.8: focused != unfocused). */
#check_editor_panel Button {
    width: auto;
    height: 1;
    min-width: 6;
    border: none;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    background: $bg-panel;
    color: $accent-calm;
}

#check_editor_panel Button:focus {
    text-style: bold reverse;
}

#check_validate_button {
    color: #54efae;                   /* insight_style.GREEN */
}

/* The ONE filled element besides the ledger (LLR-145.9): Write. */
#check_editor_panel Button.fill-accent {
    background: #54efae;              /* insight_style.GREEN */
    color: $bg-base;
}

/* Tab chips: unfocused, focused and selected are pairwise distinct
 * (LLR-145.8); the selection style is not a fill (§1.3). */
#check_editor_panel .tab-chip {
    margin-right: 0;
    text-style: none;
    background: $bg-panel;
    color: #969aad;                   /* insight_style.DGRAY */
}

#check_editor_panel .tab-chip.chip-selected {
    background: $rule;
    color: $accent-calm;
    text-style: bold;
}

#check_editor_panel .tab-chip:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold;
}

/* Focused AND selected reads differently from focused only (code-reviewer
 * F10): the selected tab keeps an underline under the focus fill. */
#check_editor_panel .tab-chip.chip-selected:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold underline;
}


/* batch-97 patch_editor — the ledger + inspector (HLR-144, pe_A).
 *
 * ONE scoped section (D23): every selector below starts with
 * `#patch_editor_panel`, so nothing here can restyle the Check Editor, whose
 * rows still carry the `patch-docked-row` / `patch-chip*` classes (Inc-3 F9;
 * the unscoped `.patch-docked-row, .patch-docked-group` rule above stays as
 * shipped). CSS expresses every split it can: the ledger `3fr`, the inspector
 * `2fr`, the ledger table `height: 1fr` as the growing region (LLR-149.5), the
 * JSON view and the paste buffer `1fr` each, and every row outside the two
 * columns one terminal row with no margin (design §3, Patch budget). Python
 * sizes only the ledger columns and the strip's bytes per row (`patch_layout`,
 * D21). Hues: the Calm Dark tokens plus insight_style.DGRAY / PURPLE, already
 * claimed by the hue census. */
#patch_editor_panel {
    width: 100%;
    height: 1fr;
    padding: 0;
    layout: vertical;
    overflow-x: hidden;
    overflow-y: auto;
}

#patch_editor_panel #patch_identity_ribbon,
#patch_editor_panel #patch_doc_empty_state,
#patch_editor_panel #patch_json_heading,
#patch_editor_panel #patch_json_stamp,
#patch_editor_panel #patch_paste_heading,
#patch_editor_panel #patch_legend {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#patch_editor_panel #patch_identity_ribbon,
#patch_editor_panel #patch_legend {
    padding: 0 1;
}

#patch_editor_panel #patch_legend,
#patch_editor_panel #patch_doc_empty_state,
#patch_editor_panel #patch_json_heading,
#patch_editor_panel #patch_json_stamp,
#patch_editor_panel #patch_paste_heading,
#patch_editor_panel #patch_checks_help,
#patch_editor_panel .pe-label {
    color: #969aad;                   /* insight_style.DGRAY */
}

#patch_editor_panel #patch_main {
    height: 1fr;
    min-height: 12;
}

#patch_editor_panel #patch_win_script {
    width: 3fr;
    height: 100%;
    padding: 0;
    border: round $rule;
    border-title-color: #969aad;      /* insight_style.DGRAY */
    border-subtitle-color: #969aad;   /* insight_style.DGRAY */
}

/* The 45-cell floor keeps the pane's 41 content cells, so the execute row
 * and the strip's 8-byte rows fit at 120-133 columns too, where the rail
 * widens; the ledger then pays (its table scrolls sideways there). */
#patch_editor_panel #patch_inspector {
    width: 2fr;
    min-width: 45;
    height: 100%;
    padding: 0 1;
    border: round $rule;
    border-title-color: #969aad;      /* insight_style.DGRAY */
}

#patch_editor_panel #patch_win_script:focus-within,
#patch_editor_panel #patch_inspector:focus-within {
    border: round $accent-calm;
}

#patch_editor_panel #patch_win_script_body {
    height: 100%;
    padding: 0;
    overflow-x: hidden;
}

#patch_editor_panel #patch_pane_entries {
    height: 100%;
}

#patch_editor_panel #patch_doc_entries_table {
    height: 1fr;
    margin: 0;
    background: $bg-base;             /* empty ledger rows: plain background (§3) */
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#patch_editor_panel #patch_doc_empty_state {
    padding: 0 1;
}

#patch_editor_panel #patch_tabs,
#patch_editor_panel #patch_doc_entry_buttons,
#patch_editor_panel #patch_paste_controls,
#patch_editor_panel #patch_history_controls,
#patch_editor_panel #patch_execute_buttons,
#patch_editor_panel #patch_before_after_buttons,
#patch_editor_panel #patch_paste_head,
#patch_editor_panel .pe-row {
    layout: horizontal;
    height: 1;
    padding: 0;
}

#patch_editor_panel #patch_tab_switcher {
    height: 1fr;
}

/* The Inspector pane: strip, form, chips, tally (design §3). Its 1-cell
 * scrollbar gutter is part of the strip's width rule (D5 (f)). */
#patch_editor_panel #patch_pane_inspector {
    height: 1fr;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#patch_editor_panel #patch_before_after_card {
    border-title-color: #969aad;      /* insight_style.DGRAY */
}

/* Three input rows with one spacer row between them (operator, Inc-4 gate
 * 2026-10-21): 3 + 2 rows. With the strip at its 8-row cap and its note the
 * Add / Edit / Remove chips then sit 2 rows below the fold at 118x53 (1 at
 * 118x54), reached by tab or by scrolling the pane (design §3 budget). */
#patch_editor_panel #patch_doc_entry_inputs {
    height: 5;
    margin-top: 1;
    padding: 0;
}

#patch_editor_panel #patch_doc_entry_inputs .pe-row {
    margin-bottom: 1;
}

#patch_editor_panel #patch_doc_entry_inputs .pe-row:last-of-type {
    margin-bottom: 0;
}

#patch_editor_panel .pe-label {
    width: 8;
    height: 1;
}

#patch_editor_panel #patch_entry_address_input,
#patch_editor_panel #patch_entry_value_input,
#patch_editor_panel #patch_entry_bytes_input,
#patch_editor_panel #patch_saveback_name_input {
    width: 1fr;
    margin: 0;
}

/* The entry inputs read as fields: a background lighter than the pane's
 * `$bg-base` (operator, Inc-4 gate 2026-10-21). */
#patch_editor_panel #patch_entry_address_input,
#patch_editor_panel #patch_entry_value_input,
#patch_editor_panel #patch_entry_bytes_input {
    background: $rule;
}

#patch_editor_panel #patch_saveback_row .pe-label {
    width: auto;
    padding: 0 1 0 0;
}

#patch_editor_panel #patch_doc_tally {
    height: auto;
    margin-top: 1;
}

/* The JSON tab: LOADED DOCUMENT (read-only) over the PASTE BUFFER, then the
 * paste, history and execute rows; the two text areas share the height. */
#patch_editor_panel #patch_win_json,
#patch_editor_panel #patch_win_checks {
    height: 100%;
    layout: vertical;
    /* Below the range (LLR-149.6) the tab's rows outgrow it: it scrolls. */
    overflow-y: auto;
}

#patch_editor_panel #patch_json_view,
#patch_editor_panel #patch_paste_text {
    height: 1fr;
    min-height: 3;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
    /* Muted bars (ux 4a, Inc-4 gate): a DGRAY thumb on the panel tone, so
     * the two bands do not read as accents; both still scroll sideways. */
    scrollbar-background: $bg-panel;
    scrollbar-background-hover: $bg-panel;
    scrollbar-background-active: $bg-panel;
    scrollbar-color: #969aad 40%;     /* insight_style.DGRAY */
    scrollbar-color-hover: #969aad 70%;
    scrollbar-color-active: #969aad;
    scrollbar-corner-color: $bg-panel;
}

/* The paste buffer keeps its 8-line floor (the batch-31 / RC-3 floor); below
 * the range the JSON tab scrolls to reach the rows under it. */
#patch_editor_panel #patch_paste_text {
    min-height: 8;
}

#patch_editor_panel #patch_win_json_body {
    height: 1fr;
    min-height: 9;                    /* the heading + the 8-line paste floor */
    padding: 0;
    overflow-x: hidden;
}

#patch_editor_panel #patch_paste_row {
    height: 100%;
}

#patch_editor_panel #patch_paste_heading {
    width: 1fr;
}

#patch_editor_panel #patch_paste_gauge {
    width: auto;
    padding: 0;
}

#patch_editor_panel #patch_history_strip,
#patch_editor_panel #patch_execute_row,
#patch_editor_panel #patch_saveback_row,
#patch_editor_panel #patch_before_after_row,
#patch_editor_panel #patch_checks_controls {
    height: auto;
    padding: 0;
}

#patch_editor_panel #patch_execute_row .patch-field-label,
#patch_editor_panel #patch_before_after_row .patch-field-label,
#patch_editor_panel #patch_scope_line {
    padding: 0;
}

/* Three save-back buttons need 48 cells against the pane's 41 at 118
 * columns: two rows, the Width selector first (design §3). */
#patch_editor_panel #patch_saveback_buttons {
    layout: grid;
    grid-size: 2;
    grid-columns: auto 1fr;
    height: auto;
    padding: 0;
}

#patch_editor_panel #patch_win_checks_body {
    height: 1fr;
    padding: 0;
}

/* Moved into the section at the Inc-4 gate (code-reviewer F2). */
#patch_editor_panel #patch_doc_issues,
#patch_editor_panel #patch_checks_results {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#patch_editor_panel #patch_checks_status,
#patch_editor_panel #patch_doc_issue_count,
#patch_editor_panel #patch_checks_help {
    width: 100%;
    padding: 0;
}

/* The file row and the document controls: one row each, inside the panel. */
#patch_editor_panel #patch_doc_file_row,
#patch_editor_panel #patch_doc_controls {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}

#patch_editor_panel #patch_doc_file_line1 {
    width: 1fr;
    height: 1;
}

#patch_editor_panel #patch_doc_file_line2 {
    width: auto;
    height: 1;
}

#patch_editor_panel #patch_doc_file_select {
    width: 1fr;
    height: 1;
    margin-right: 1;
}

#patch_editor_panel #patch_doc_path_input {
    width: 2fr;
    margin: 0 1 0 0;
}

/* One-row chips: a focused chip reverses (LLR-144.10: focused != unfocused). */
#patch_editor_panel .patch-chip {
    width: auto;
    min-width: 4;
    padding: 0;
    margin-right: 1;
    background: $bg-panel;
}

#patch_editor_panel .patch-chip:focus {
    text-style: bold reverse;
}

/* The ONE filled element besides the ledger (LLR-144.11): Save. */
#patch_editor_panel .patch-chip-apply .patch-chip.fill-accent {
    background: #b565f3;              /* insight_style.PURPLE */
    color: $bg-base;
}

/* Tab chips: unfocused, focused, selected and focused+selected pairwise
 * distinct (LLR-144.10); the selection style is not a fill (§1.3). */
#patch_editor_panel .tab-chip {
    width: auto;
    height: 1;
    min-width: 6;
    border: none;
    padding: 0 1;
    margin-right: 0;
    text-style: none;
    background: $bg-panel;
    color: #969aad;                   /* insight_style.DGRAY */
}

#patch_editor_panel .tab-chip.chip-selected {
    background: $rule;
    color: $accent-calm;
    text-style: bold;
}

#patch_editor_panel .tab-chip:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold;
}

#patch_editor_panel .tab-chip.chip-selected:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold underline;
}

/* batch-97 flow_builder — the pipeline rail (HLR-146, fb_A, decision B).
 *
 * ONE scoped section (D23): every selector below starts with `#flow_panel`,
 * so nothing here restyles Flow Execution, which shares `.flow-name-strip`
 * (the ribbon's margin and weight are overridden here, the shared rule stays
 * as shipped). Vertical budget (design §3, LED-…97.11): the pipeline frame
 * is exactly as tall as its cards (`height: auto`, + the horizontal
 * scrollbar row when the cards overflow), every other row is one terminal
 * row with no margin, and the result area under Run is the growing region
 * (`height: 1fr`). Python sizes only the card width and the ribbon text
 * (`pipeline_layout`, D21). Hues: the Calm Dark tokens plus
 * insight_style.DGRAY / YELLOW, already claimed by the hue census.
 * Gate fold (operator decision 2, LED-…97.25, fb_A's air): one named
 * separator row above the kind chips, the copy/paste strip and the run row,
 * and a rule row opening the result area. */
#flow_panel #flow_ribbon {
    height: 1;
    padding: 0;
}

#flow_panel #flow_name_strip {
    width: 1fr;
    height: 1;
    margin: 0;
    padding: 0 1;
    text-style: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#flow_panel #flow_pipeline_scroll {
    height: auto;
    padding: 0 1;
    border: round $rule;
    border-title-color: #969aad;      /* insight_style.DGRAY */
    border-subtitle-color: #f6ff8f;   /* insight_style.YELLOW (.sev-warning) */
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
}

#flow_panel #flow_pipeline_scroll:focus {
    border: round $accent-calm;
}

#flow_panel #flow_pipeline {
    width: auto;
    height: auto;
}

#flow_panel #flow_palette,
#flow_panel #flow_clip_row,
#flow_panel #flow_funnel_editor,
#flow_panel #flow_run_row {
    height: 1;
    padding: 0 1;
}

#flow_panel #flow_palette,
#flow_panel #flow_clip_row,
#flow_panel #flow_run_row {
    margin-top: 1;
}

#flow_panel #flow_add_row {
    height: auto;
    padding: 0 1;
}

#flow_panel .flow-kind-tag {
    width: 13;
    height: 1;
}

#flow_panel .flow-add-fields {
    width: 1fr;
    height: auto;
}

#flow_panel .flow-add-line,
#flow_panel #flow_ext_row {
    height: 1;
}

#flow_panel .flow-field-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: #969aad;                   /* insight_style.DGRAY */
}

#flow_panel Input {
    background: $odd-row;
}

#flow_panel Input:focus {
    background: $rule;
}

#flow_panel Select > SelectCurrent {
    background: $odd-row;
}

#flow_panel #flow_ref,
#flow_panel #flow_ref_a,
#flow_panel #flow_ref_b,
#flow_panel #flow_ext_instruction,
#flow_panel #flow_ext_log,
#flow_panel #flow_ext_output,
#flow_panel #flow_funnel_value {
    width: 1fr;
    margin-right: 1;
}

#flow_panel #flow_pick {
    width: 6;
    margin-right: 1;
}

#flow_panel #flow_funnel_name {
    width: 24;
    margin-right: 1;
}

#flow_panel #flow_gating {
    width: 18;
    margin-right: 1;
}

#flow_panel #flow_ext_mode {
    width: 14;
    margin-right: 1;
}

#flow_panel #flow_clip_status {
    width: 1fr;
    height: 1;
    color: #969aad;                   /* insight_style.DGRAY */
}

#flow_panel #flow_funnel_list {
    height: auto;
    max-height: 3;
    padding: 0 1 0 2;
}

#flow_panel #flow_wiring_notice {
    height: auto;
    padding: 0 1;
}

/* One-row chips (LLR-146.5): Button's 3-row bordered shape collapsed to one
 * row, padded by Button's own one-cell line pad only, so the seven kind
 * chips fit the 96-cell panel of the 120-133 band; a focused chip reverses
 * (LLR-146.13: focused != unfocused). */
#flow_panel Button {
    width: auto;
    height: 1;
    min-width: 6;
    border: none;
    padding: 0;
    margin-right: 1;
    text-style: bold;
    background: $bg-panel;
    color: $accent-calm;
}

#flow_panel Button:focus {
    text-style: bold reverse;
}

/* The ONE filled element besides the pipeline (LLR-146.5): Run. */
#flow_panel Button.fill-accent {
    background: $accent-calm;
    color: $bg-base;
}

#flow_panel Button.fill-accent:focus {
    background: $fg-base;
    color: $bg-base;
    text-style: bold;
}

/* Kind chips: unfocused, focused and selected pairwise distinct
 * (LLR-146.13); the selection style is not the fill (LLR-146.5). */
#flow_panel .kind-chip {
    text-style: none;
    background: $bg-panel;
    color: #969aad;                   /* insight_style.DGRAY */
}

#flow_panel .kind-chip.chip-selected {
    background: $rule;
    color: $accent-calm;
    text-style: bold;
}

#flow_panel .kind-chip:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold;
}

#flow_panel .kind-chip.chip-selected:focus {
    background: $accent-calm;
    color: $bg-base;
    text-style: bold underline;
}

/* The growing region (decision B): a rule row on top (the `.flow-sep`
 * tone), no side border; one empty-state line before the first run, the
 * block verdicts after it — from the banner on, with no blank row after it
 * (ux L2) nor before the memory ribbon, and each written path on one row,
 * its tail kept (ux M1): a 4-block run fits at 118x53 without scrolling. */
#flow_panel #flow_result {
    height: 1fr;
    min-height: 3;
    border: none;
    border-top: solid $rule;
    padding: 0 1;
}

#flow_panel .flow-banner {
    margin-bottom: 0;
}

#flow_panel .flow-ribbon {
    margin-top: 0;
}

#flow_panel .flow-wrote-path {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#flow_panel .flow-result-empty {
    height: 1;
}

#flow_panel #flow_legend {
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
