+"""Audit the WinCI pytest JUnit report without hiding the pytest exit code."""
+
+from __future__ import annotations
+
+import argparse
+import re
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass, field
+from pathlib import Path
+
+EXPECTED_AT_NODES = 28
+AT_TEST_PREFIX = "test_copy_paste_acceptance_cell[AT-I1b-"
+MANUAL_TEST = "test_manual_windows_terminal_operator_acceptance"
+MATRIX_CLASS = "test_b103_copy_paste_matrix"
+LINUX_ONLY_REASON = re.compile(
+    r"^\s*Linux(?:-only\b| only\b| failing-writer arm\b)", re.IGNORECASE
+)
+
+
+@dataclass
+class Audit:
+    total: int = 0
+    passed: int = 0
+    failed: int = 0
+    errors: int = 0
+    skipped: int = 0
+    at_nodeids: list[str] = field(default_factory=list)
+    allowed_skips: list[tuple[str, str]] = field(default_factory=list)
+    violations: list[str] = field(default_factory=list)
+
+
+def _nodeid(testcase: ET.Element) -> str:
+    classname = testcase.get("classname", "")
+    name = testcase.get("name", "")
+    return f"{classname}::{name}" if classname else name
+
+
+def _allowed_skip(nodeid: str, reason: str) -> str | None:
+    if LINUX_ONLY_REASON.match(reason):
+        return "linux-only"
+    classname, separator, name = nodeid.rpartition("::")
+    if (
+        separator
+        and classname.endswith(MATRIX_CLASS)
+        and name == MANUAL_TEST
+        and "AT-I1b-8" in reason
+        and re.search(r"\bmanual\b", reason, re.IGNORECASE)
+    ):
+        return "at-i1b-8-manual"
+    return None
+
+
+def _declared_count(root: ET.Element, attribute: str) -> int:
+    suites = list(root.iter("testsuite"))
+    if not suites and root.tag == "testsuite":
+        suites = [root]
+    total = 0
+    for suite in suites:
+        raw = suite.get(attribute, "0")
+        try:
+            value = int(raw)
+        except ValueError:
+            return -1
+        if value < 0:
+            return -1
+        total += value
+    return total
+
+
+def audit_junit(path: Path, pytest_exit: int) -> Audit:
+    root = ET.parse(path).getroot()
+    audit = Audit()
+    if pytest_exit:
+        audit.violations.append(f"PYTEST_EXIT code={pytest_exit}")
+
+    testcases = list(root.iter("testcase"))
+    audit.total = len(testcases)
+    if not testcases:
+        audit.violations.append("JUNIT_EMPTY")
+
+    for testcase in testcases:
+        nodeid = _nodeid(testcase)
+        name = testcase.get("name", "")
+        classname = testcase.get("classname", "")
+        failed = testcase.find("failure") is not None
+        errored = testcase.find("error") is not None
+        skipped = testcase.find("skipped")
+        if failed:
+            audit.failed += 1
+            audit.violations.append(f"FAILURE node={nodeid}")
+        if errored:
+            audit.errors += 1
+            audit.violations.append(f"ERROR node={nodeid}")
+        if skipped is not None:
+            audit.skipped += 1
+            reason = skipped.get("message") or skipped.text or ""
+            allowed = _allowed_skip(nodeid, reason)
+            if allowed is None:
+                audit.violations.append(f"DISALLOWED_SKIP node={nodeid}")
+            else:
+                audit.allowed_skips.append((allowed, nodeid))
+        if not failed and not errored and skipped is None:
+            audit.passed += 1
+        if classname.endswith(MATRIX_CLASS) and name.startswith(AT_TEST_PREFIX):
+            audit.at_nodeids.append(nodeid)
+
+    unique_at = set(audit.at_nodeids)
+    if len(unique_at) != EXPECTED_AT_NODES:
+        audit.violations.append(
+            f"AT_CENSUS expected={EXPECTED_AT_NODES} unique={len(unique_at)}"
+        )
+    if len(unique_at) != len(audit.at_nodeids):
+        audit.violations.append("AT_DUPLICATE_NODEID")
+
+    declared_failures = _declared_count(root, "failures")
+    declared_errors = _declared_count(root, "errors")
+    if declared_failures != audit.failed:
+        audit.violations.append(
+            f"JUNIT_FAILURE_COUNT declared={declared_failures} actual={audit.failed}"
+        )
+    if declared_errors != audit.errors:
+        audit.violations.append(
+            f"JUNIT_ERROR_COUNT declared={declared_errors} actual={audit.errors}"
+        )
+    return audit
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--junit-xml", type=Path, required=True)
+    parser.add_argument("--pytest-exit", type=int, required=True)
+    args = parser.parse_args(argv)
+    try:
+        audit = audit_junit(args.junit_xml, args.pytest_exit)
+    except (OSError, ET.ParseError) as exc:
+        print(f"VIOLATION JUNIT_UNREADABLE error={type(exc).__name__}")
+        return args.pytest_exit or 2
+
+    print(
+        "WINCI_GATE "
+        f"tests={audit.total} passed={audit.passed} failed={audit.failed} "
+        f"errors={audit.errors} skipped={audit.skipped} "
+        f"at_nodes={len(set(audit.at_nodeids))}"
+    )
+    for category, nodeid in audit.allowed_skips:
+        print(f"ALLOWED_SKIP category={category} node={nodeid}")
+    for violation in audit.violations:
+        print(f"VIOLATION {violation}")
+    exit_code = args.pytest_exit or (1 if audit.violations else 0)
+    print(
+        f"WINCI_GATE_RESULT {'PASS' if exit_code == 0 else 'FAIL'} "
+        f"violations={len(audit.violations)} pytest_exit={args.pytest_exit} "
+        f"gate_exit={exit_code}"
+    )
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
